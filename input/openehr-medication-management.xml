<?xml version="1.0" encoding="UTF-8"?>
<!-- Modelled on openehr-fhir/test-ig/input/openehr-test.xml -->
<ImplementationGuide xmlns="http://hl7.org/fhir">
  <id value="hl7.fhir.uv.openehr-medication-management"/>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status">
    <valueCode value="informative"/>
  </extension>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-wg">
    <valueCode value="fhir"/>
  </extension>
  <extension url="http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm">
    <valueInteger value="0"/>
  </extension>
  <url value="http://hl7.org/fhir/uv/openehr-medication-management/ImplementationGuide/hl7.fhir.uv.openehr-medication-management"/>
  <version value="0.1.0"/>
  <name value="OpenEHRMedicationManagement"/>
  <title value="openEHR Medication Management Implementation Guide"/>
  <status value="draft"/>
  <experimental value="false"/>
  <publisher value="HL7 International / FHIR Infrastructure"/>
  <contact>
    <name value="HL7 International / FHIR Infrastructure"/>
    <telecom>
      <system value="url"/>
      <value value="http://www.hl7.org/Special/committees/fiwg"/>
    </telecom>
  </contact>
  <description value="Demonstration Implementation Guide that publishes an openEHR use case (inpatient medication order and order status) with the HL7 FHIR IG Publisher. It contains the openEHR archetypes as logical models, the CISTEC medication order template as a WebTemplate, and example compositions."/>
  <jurisdiction>
    <coding>
      <system value="http://unstats.un.org/unsd/methods/m49/m49.htm"/>
      <code value="001"/>
      <display value="World"/>
    </coding>
  </jurisdiction>
  <packageId value="hl7.fhir.uv.openehr-medication-management"/>
  <license value="CC-BY-4.0"/>
  <fhirVersion value="5.0.0"/>
  <dependsOn id="openehrbase">
    <uri value="http://openehr.org/fhir/ImplementationGuide/openehr.base"/>
    <packageId value="openehr.base"/>
    <version value="0.1.0-snapshot"/>
  </dependsOn>
  <definition>
    <!-- Archetypes are listed automatically. The WebTemplate is not a FHIR resource, so it needs an explicit name -->
    <resource>
      <reference>
        <reference value="WebTemplate/cistec.openehr.medicationorder.v1"/>
      </reference>
      <name value="Medication order (cistec.openehr.medication_order.v1)"/>
      <description value="CISTEC openEHR template for an inpatient medication order and its order status, rendered from the Archetype Designer web template export."/>
    </resource>
    <page>
      <name value="index.html"/>
      <title value="Home"/>
      <generation value="markdown"/>
      <page>
        <name value="background.html"/>
        <title value="Background"/>
        <generation value="markdown"/>
      </page>
      <page>
        <name value="template.html"/>
        <title value="Medication Order Template"/>
        <generation value="markdown"/>
      </page>
      <page>
        <name value="terminology.html"/>
        <title value="Terminology"/>
        <generation value="markdown"/>
      </page>
      <page>
        <name value="examples.html"/>
        <title value="Examples"/>
        <generation value="markdown"/>
      </page>
      <page>
        <name value="known-issues.html"/>
        <title value="Known Issues"/>
        <generation value="markdown"/>
      </page>
      <page>
        <name value="downloads.html"/>
        <title value="Downloads"/>
        <generation value="markdown"/>
      </page>
    </page>
    <!-- copyright year is a mandatory parameter -->
    <parameter>
      <code>
        <system value="http://hl7.org/fhir/tools/CodeSystem/ig-parameters"/>
        <code value="copyrightyear"/>
      </code>
      <value value="2026+"/>
    </parameter>
    <parameter>
      <code>
        <system value="http://hl7.org/fhir/tools/CodeSystem/ig-parameters"/>
        <code value="releaselabel"/>
      </code>
      <value value="ci-build"/>
    </parameter>
    <!-- ADL archetypes: loaded as logical models because the IG depends on openehr.base -->
    <parameter>
      <code>
        <system value="http://hl7.org/fhir/tools/CodeSystem/ig-parameters"/>
        <code value="path-resource"/>
      </code>
      <value value="input/archetypes"/>
    </parameter>
    <!-- WebTemplate JSON. The OPT lives in input/images (download only): the publisher cannot load OPT XML -->
    <parameter>
      <code>
        <system value="http://hl7.org/fhir/tools/CodeSystem/ig-parameters"/>
        <code value="path-resource"/>
      </code>
      <value value="input/templates"/>
    </parameter>
    <!-- No "openehr" parameter: the publisher enables openEHR loading from the openehr.base dependency
         and reports the parameter as unknown -->
    <parameter>
      <code>
        <system value="http://hl7.org/fhir/tools/CodeSystem/ig-parameters"/>
        <code value="show-inherited-invariants"/>
      </code>
      <value value="false"/>
    </parameter>
  </definition>
</ImplementationGuide>
