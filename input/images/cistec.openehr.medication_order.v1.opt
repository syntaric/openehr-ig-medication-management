                                                        </attributes>
                                                        <archetype_id>
                                                            <value>openEHR-EHR-CLUSTER.timing_daily.v1</value>
                                                        </archetype_id>
                                                        <term_definitions code="at0000">
                                                            <items id="text">Timing night</items>
                                                            <items id="description">Structured information about the intended timing of a therapeutic or diagnostic activity within the night.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0003">
                                                            <items id="text">Frequency</items>
                                                            <items id="description">The frequency as number of times per time period that the activity is to take place.</items>
                                                            <items id="comment">For example: "4 times per day" or "3 to 4 times per hour".</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0004">
                                                            <items id="text">Time period for application</items>
                                                            <items id="description">A specific time or interval of time when the activity should occur.</items>
                                                            <items id="comment">For example: "08:00" or "15:00-16:00".
Although a specific point in time can be recorded, a time interval is more appropriate for a "Schema" medication order.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0014">
                                                            <items id="text">Interval</items>
                                                            <items id="description">The time interval or minimum and maximum range of an interval between each scheduled activity.</items>
                                                            <items id="comment">For example: "Every 4 hours" or "Every 4 to 6 hours".</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0023">
                                                            <items id="text">Exact timing critical?</items>
                                                            <items id="description">Is exact timing of the activity critical to effectiveness, or patient safety or wellbeing?</items>
                                                            <items id="comment">For example when administering antiparkinson medications.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0024">
                                                            <items id="text">As required</items>
                                                            <items id="description">Record as True if the medication should only be administered at the time specified in the "Therapeutic Direction" if required by the patient.</items>
                                                            <items id="comment">If this is set to True, the patient should be actively offered the medication before administration at the time specified in the "Therapeutic Direction", who can choose whether he needs it or not.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0025">
                                                            <items id="text">'As required' criterion</items>
                                                            <items id="description">The condition which triggers an 'As required' activity.</items>
                                                            <items id="comment">For example: "for pain".</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0026">
                                                            <items id="text">Event name</items>
                                                            <items id="description">The name of the event that triggers the activity to take place.</items>
                                                            <items id="comment">For example: "Before each meal", "at bedtime", "in the morning". It is understood that these event names may not equate to the same exact times in different cultures. Coding with a terminology, for example HL7 FHIR Named events, is recommended where appropriate.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0027">
                                                            <items id="text">Timing description</items>
                                                            <items id="description">Text description of the daily timing. This element is intended to allow implementers to use the structures for different timings without necessarily specifying the timings in a structured way.</items>
                                                            <items id="comment">For example: "Take morning and evening".</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0035">
                                                            <items id="text">On / off cycle</items>
                                                            <items id="description">A cycle of activity where an on-off pattern is required.</items>
                                                            <items id="comment">For example: "Apply an ice pack on for 20 minutes, off for an hour, repeat".</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0036">
                                                            <items id="text">On</items>
                                                            <items id="description">The period of time for which the activity should take place.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0037">
                                                            <items id="text">Off</items>
                                                            <items id="description">The period of time for which the activity should NOT take place.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0038">
                                                            <items id="text">Repetitions</items>
                                                            <items id="description">The number of repetitions of the on/off cycle.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0039">
                                                            <items id="text">Specific event</items>
                                                            <items id="description">A specific, named time event that the activity should occur in relation to.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0040">
                                                            <items id="text">Time offset</items>
                                                            <items id="description">The period of time before or after the named event when the activity should take place. Negative durations can be used to signify that the activity should take place before the event.</items>
                                                            <items id="comment">For example: '30 minutes after meal = meal + 30 minutes', '2 hours before bedtime = bedtime -2 hours'.</items>
                                                        </term_definitions>
                                                    </children>
