    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.timing_nondaily.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Zeitablauf - nicht täglich</items>
                <items id="description">Strukturierte Informationen über das geplante Zeitablaufmuster für eine therapeutische oder diagnostische Aktivität, die sich über Tage, Wochen, Monate oder Jahre erstreckt.</items>
            </items>
            <items code="at0001">
                <items id="text">Bestimmtes Datum der erstmaligen Anwendung</items>
                <items id="description">Ein bestimmtes Datum für das erstmalige Stattfinden der Aktivität, an dem die Periodizität startet.</items>
                <items id="comment">Zum Beispiel: "am 12. Januar 2017"
Die Uhrzeit der erstmaligen Anwendung ist in openEHR-EHR-CLUSTER.timing_daily.v1/Specific time for first application[at0004] gespeichert.</items>
            </items>
            <items code="at0002">
                <items id="text">Wiederholungsintervall für Tage</items>
                <items id="description">Das Intervall zwischen den Wiederholungen der Aktivität.</items>
                <items id="comment">Zum Beispiel: "Alle 3 Wochen". Falls erforderlich, kann mit diesem Element explizit angegeben werden, dass eine Aktivität jeden einzelnen Tag stattfinden soll, indem es auf "1 Tag" gesetzt wird.</items>
            </items>
            <items code="at0003">
                <items id="text">Bestimmter Wochentag</items>
                <items id="description">Die Aktivität sollte an einem bestimmten Wochentag stattfinden.</items>
                <items id="comment">Zum Beispiel: "Am Montag, Mittwoch und Freitag".</items>
            </items>
            <items code="at0004">
                <items id="text">Bestimmter Tag des Monats</items>
                <items id="description">Die Aktivität sollte an einem bestimmten Tag im Monat oder in einem Intervall von mehreren Tagen in dem Monat stattfinden.</items>
                <items id="comment">Zum Beispiel: "am 3., 13. und 23. jedes Monats" oder "vom 1. bis zum 10. jedes Monats"</items>
            </items>
            <items code="at0005">
                <items id="text">Name des Ereignisses</items>
                <items id="description">Der Name des Ereignisses, das die Aktivität auslöst.</items>
                <items id="comment">Dieses Element ist für Ereignisse gedacht, die zu verschiedenen Zeitpunkten auftreten können, wie z.B. Beginn der Menstruation, und nicht für Dosis oder Aktivitäten, die von einer anderen Variable abhängen. Bei Bedarf kann der Name des Ereignisses mit einer Terminologie kodiert werden, mit der die Anwendung ein bestimmtes Datum für die Aktivität festlegen kann.</items>
            </items>
            <items code="at0006">
                <items id="text">Bestimmtes Ereignis</items>
                <items id="description">Ein bestimmtes, benanntes Zeitereignis, auf das sich die Aktivität bezieht und stattfinden soll.</items>
            </items>
            <items code="at0007">
                <items id="text">Montag</items>
                <items id="description">Die Aktivität sollte am Montag stattfinden.</items>
            </items>
            <items code="at0008">
                <items id="text">Dienstag</items>
                <items id="description">Die Aktivität sollte am Dienstag stattfinden.</items>
            </items>
            <items code="at0009">
                <items id="text">Zeitspanne</items>
                <items id="description">Das Zeitintervall vor oder nach dem Ereignis, in dem die Aktivität stattfinden sollte. Negative Intervalle können verwendet werden, damit signalisiert werden kann, dass die Aktivität vor dem genannten Ereignis stattfinden soll.</items>
                <items id="comment">Zum Beispiel: "3 Tage nach Beginn der Menstruation = Beginn der Menstruation + 3 Tage", "2 Wochen vor der Aufnahme = Aufnahme - 2 Wochen".</items>
            </items>
            <items code="at0010">
                <items id="text">Ein/Aus-Zyklus</items>
                <items id="description">Ein Aktivitätszyklus, bei dem ein Ein/Aus-Zyklus erforderlich ist.</items>
                <items id="comment">Zum Beispiel: "1 Woche nehmen, 2 Wochen auslassen, 4 Mal wiederholen".</items>
            </items>
            <items code="at0011">
                <items id="text">Ein</items>
                <items id="description">Der Zeitraum, in dem die Aktivität ausgeführt werden soll.</items>
            </items>
            <items code="at0012">
                <items id="text">Aus</items>
                <items id="description">Der Zeitraum, in dem die Aktivität NICHT stattfinden soll.</items>
            </items>
            <items code="at0013">
                <items id="text">Wiederholungen</items>
                <items id="description">Die Häufigkeit, mit der der Ein/Aus-Zyklus wiederholt werden soll.</items>
            </items>
            <items code="at0014">
                <items id="text">Tage pro Zeitintervall</items>
                <items id="description">Die Anzahl der Tage pro Zeitintervall, an denen die Aktivität stattfindet.</items>
                <items id="comment">Zum Beispiel: „3 Tage pro Woche“, „2–4 Tage pro Monat“. Spezifische Angaben zum zeitlichen Ablauf innerhalb jedes 24-Stunden-Zeitraums werden im Archetyp CLUSTER.timing_daily angegeben.</items>
            </items>
            <items code="at0016">
                <items id="text">Mittwoch</items>
                <items id="description">Die Aktitvität sollte am Mittwoch stattfinden.</items>
            </items>
            <items code="at0017">
                <items id="text">Donnerstag</items>
                <items id="description">Die Aktivität sollte am Donnerstag stattfinden.</items>
            </items>
            <items code="at0018">
                <items id="text">Freitag</items>
                <items id="description">Die Aktivität sollte am Freitag stattfinden.</items>
            </items>
            <items code="at0019">
                <items id="text">Samstag</items>
                <items id="description">Die Aktivität sollte am Samstag stattfinden.</items>
            </items>
            <items code="at0020">
                <items id="text">Sonntag</items>
                <items id="description">Die Aktivität sollte am Sonntag stattfinden.</items>
            </items>
            <items code="at0021">
                <items id="text">Beschreibung des Zeitablaufs</items>
                <items id="description">Freitextbeschreibung des Zeitablaufs.</items>
                <items id="comment">Zum Beispiel: "Eine Woche verwenden, dann zwei Wochen pausieren und dann wiederholen". Dieses Element soll es ermöglichen, die Strukturen für tägliche Zeitabläufe zu verwenden, ohne notwendigerweise die Struktur der nicht-täglichen Zeitabläufe angeben zu müssen.</items>
            </items>
            <items code="at0022">
                <items id="text">Aktivitäten pro Zeitintervall</items>
                <items id="description">Die Anzahl der Aktivitäten pro Zeitintervall.</items>
                <items id="comment">Zum Beispiel: „3 Aktivitäten pro Woche“, „2-4 Mal pro Monat“.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">*Timing - non-daily (en)</items>
                <items id="description">*Structured information about the intended timing pattern for a therapeutic or diagnostic activity occurring over days, weeks, months or years. (en)</items>
            </items>
            <items code="at0001">
                <items id="text">*Specific date (en)</items>
                <items id="description">*The activity should take place on a specific date or a specific range of dates. (en)</items>
                <items id="comment">*For example: 'on 12 Jan 2017' or 'on 30 Oct 2017 to 6 Nov 2017'. (en)</items>
            </items>
            <items code="at0002">
                <items id="text">*Repetition interval (en)</items>
                <items id="description">*The interval between repetitions of the activity. (en)</items>
                <items id="comment">*For example: 'Every 3 weeks'. If necessary, this element can be used to explicity specify that an activity is to take place every single day, by setting it to "1 day". (en)</items>
            </items>
            <items code="at0003">
                <items id="text">*Specific day of week (en)</items>
                <items id="description">*The activity should take place on a specific day of the week. (en)</items>
                <items id="comment">*For example: 'On Monday, Wednesday and Friday'. (en)</items>
            </items>
            <items code="at0004">
                <items id="text">*Specific day of month (en)</items>
                <items id="description">*The activity should take place on a specific day or interval of days of the month. (en)</items>
                <items id="comment">*For example: 'on the 3rd, 13th and 23rd of each month' or 'on the 1st to the 10th of each month'. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">*Event name (en)</items>
                <items id="description">*The name of the event that triggers the activity to take place. (en)</items>
                <items id="comment">*This element is intended for events that can occur at variable dates, such as onset of menstruation, and not for doses or activities that are conditional on a different varable. If required, the event name can be coded using a terminology, which could potentially be used to trigger an application to set a concrete date for the activity. (en)</items>
            </items>
            <items code="at0006">
                <items id="text">*Specific event (en)</items>
                <items id="description">*The activity should take place in relation to a specific named event. (en)</items>
            </items>
            <items code="at0007">
                <items id="text">*Monday (en)</items>
                <items id="description">*The activity should take place on Monday. (en)</items>
            </items>
            <items code="at0008">
                <items id="text">*Tuesday (en)</items>
                <items id="description">*The activity should take place on Tuesday. (en)</items>
            </items>
            <items code="at0009">
                <items id="text">*Time offset (en)</items>
                <items id="description">*The period of time before or after the named event when the activity should take place. Negative durations can be used to signify that the activity should be taken before a known event. (en)</items>
                <items id="comment">*For example: '3 days after onset of menstruation = menstrual onset + 3 days', '2 weeks prior to admission= admission -2 weeks'. (en)</items>
            </items>
            <items code="at0010">
                <items id="text">*On / off cycle (en)</items>
                <items id="description">*A cycle of activity where an on-off pattern is required. (en)</items>
                <items id="comment">*For example: 'take for 1 week, omit 2 weeks, repeat 4 times' (en)</items>
            </items>
            <items code="at0011">
                <items id="text">*On (en)</items>
                <items id="description">*The period of time for which the activity should take place. (en)</items>
            </items>
            <items code="at0012">
                <items id="text">*Off (en)</items>
                <items id="description">*The period of time for which the activity should NOT take place. (en)</items>
            </items>
            <items code="at0013">
                <items id="text">*Repetitions (en)</items>
                <items id="description">*The number of repetitions of the on/off cycle. (en)</items>
            </items>
            <items code="at0014">
                <items id="text">*Days per time period (en)</items>
                <items id="description">*The number of days per time period on which the activity takes place. (en)</items>
                <items id="comment">*For example: '3 days per week', '2-4 days per month'. Specific details about the timing within each 24 hour period is specified within the CLUSTER.timing_daily archetype. (en)</items>
            </items>
            <items code="at0016">
                <items id="text">*Wednesday (en)</items>
                <items id="description">*The activity should take place on Wednesday. (en)</items>
            </items>
            <items code="at0017">
                <items id="text">*Thursday (en)</items>
                <items id="description">*The activity should take place on Thursday. (en)</items>
            </items>
            <items code="at0018">
                <items id="text">*Friday (en)</items>
                <items id="description">*The activity should take place on Friday. (en)</items>
            </items>
            <items code="at0019">
                <items id="text">*Saturday (en)</items>
                <items id="description">*The activity should take place on Saturday. (en)</items>
            </items>
            <items code="at0020">
                <items id="text">*Sunday (en)</items>
                <items id="description">*The activity should take place on Sunday. (en)</items>
            </items>
            <items code="at0021">
                <items id="text">*Timing description (en)</items>
                <items id="description">*Text description of the timing. (en)</items>
                <items id="comment">*For example: 'Use for one week, then stop for two weeks, then repeat'. This element is intended to allow implementers to use the structures for daily timings without necessarily specifying the non-daily timings in a structured way. (en)</items>
            </items>
            <items code="at0022">
                <items id="text">*Activities per time period (en)</items>
                <items id="description">*The number of activities per time period. (en)</items>
                <items id="comment">*For example: '3 activities per week', '2-4 times per month'. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.knowledge_base_reference.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Datenbankreferenz</items>
                <items id="description">Eine Zitierung einer digitalen Ressource, die als Quelle für maßgebliche oder fachliche Informationen und / oder für in der Ressource enthaltene Elemente verwendet wird.</items>
                <items id="comment">Zum Beispiel: eine Stammdatenbank, eine Genomik-Pipeline-Historie, eine Datenbank mit genomischen Varianten oder eine Datenbank mit Leitlinien für medizinische Verfahren.</items>
            </items>
            <items code="at0001">
                <items id="text">Datenbankname</items>
                <items id="description">Name der Datenbank</items>
                <items id="comment">Zum Beispiel: hospindex, Stammdaten</items>
            </items>
            <items code="at0002">
                <items id="text">Item version</items>
                <items id="description">The version of the referenced item within the knowledge base.</items>
            </items>
            <items code="at0003">
                <items id="text">Item URI</items>
                <items id="description">Der Link zum referenzierten Item innerhalb der Datenbank.</items>
                <items id="comment">Beispiel: hospindex/2033-05/777630</items>
            </items>
            <items code="at0004">
                <items id="text">Comment</items>
                <items id="description">Additional narrative about the knowledge base, not captured in other fields.</items>
            </items>
            <items code="at0005">
                <items id="text">Codename</items>
                <items id="description">Der Name oder Kürzel des Codes oder URI.</items>
                <items id="comment">Zum Beispiel: "PRDNO" für hospINDEX Produkte, "SUBNO" für hospINDEX Substanzen, "Pharmacode" für hospINDEX Artikel.</items>
            </items>
            <items code="at0006">
                <items id="text">Datenbankversion</items>
                <items id="description">Die Version der Datenbank</items>
            </items>
            <items code="at0007">
                <items id="text">Item publication</items>
                <items id="description">Date and/or time when the item within the database was published.</items>
            </items>
            <items code="at0008">
                <items id="text">Knowledge base URI</items>
                <items id="description">The hyperlink to the referenced knowledge base.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">*Knowledge base reference (en)</items>
                <items id="description">*A citation of a digital resource used as an source of authoritative or expert information, and/or to items contained within the resource. (en)</items>
                <items id="comment">*For example: a genomics pipeline history, a database of genomic variants, or a database of healthcare procedure guidelines. (en)</items>
            </items>
            <items code="at0001">
                <items id="text">*Knowledge base name (en)</items>
                <items id="description">*The name of the knowledge base. (en)</items>
                <items id="comment">*For example: Galaxy/Snakemake; dbSNP; or CADD. (en)</items>
            </items>
            <items code="at0002">
                <items id="text">*Item version (en)</items>
                <items id="description">*The version of the referenced item within the knowledge base. (en)</items>
            </items>
            <items code="at0003">
                <items id="text">*Item URI (en)</items>
                <items id="description">*The hyperlink to the referenced item within the knowledge base. (en)</items>
            </items>
            <items code="at0004">
                <items id="text">*Comment (en)</items>
                <items id="description">*Additional narrative about the knowledge base, not captured in other fields. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">*Item name (en)</items>
                <items id="description">*The name of the referenced item within the knowledge base. (en)</items>
                <items id="comment">*For example: rs139581412. (en)</items>
            </items>
            <items code="at0006">
                <items id="text">*Knowledge base version (en)</items>
                <items id="description">*The version of the referenced knowledge base. (en)</items>
            </items>
            <items code="at0007">
                <items id="text">*Item publication (en)</items>
                <items id="description">*Date and/or time when the item within the database was published. (en)</items>
            </items>
            <items code="at0008">
                <items id="text">*Knowledge base URI (en)</items>
                <items id="description">*The hyperlink to the referenced knowledge base. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-ACTION.medication.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Status</items>
                <items id="description">Jede Aktivität in Bezug auf die Planung, Vorbereitung, Rezeptverwaltung, Ausgabe, Verabreichung, Einnahme, Absetzung und anderer Verwendung von Arzneimitteln, Impfstoffen, Nahrungsergänzungsmitteln und anderen therapeutischen Mitteln.</items>
                <items id="comment">Dies beschränkt sich nicht nur auf Aktivitäten, die auf der Grundlage von Arzneimittelverordnungen von Ärzten durchgeführt werden, sondern kann sich auch z.B. auf die Einnahme von freiverkäuflichen Medikamenten beziehen.</items>
            </items>
            <items code="at0002">
                <items id="text">Verordnung ausgestellt</items>
                <items id="description">Für das Arzneimittel wurde ein Rezept ausgestellt.</items>
            </items>
            <items code="at0003">
                <items id="text">Rezept wurde ausgegeben/eingelöst</items>
                <items id="description">Das verordnete Arzneimittel ist an einen Patienten ausgegeben worden, z.B. von einer Apotheke.</items>
            </items>
            <items code="at0004">
                <items id="text">Arzneimittelbehandlung hat begonnen</items>
                <items id="description">Das Arzneimittel wurde zum ersten Mal von dem Patienten eingenommen oder ihm verabreicht. Obwohl in einigen Situationen das relevante Datum als erste von mehreren Anwendungen errechenbar ist, kann es in der Grundversorgung sein, dass genaue Verabreichungszeit nicht ohne weiteres verfügbar ist.</items>
            </items>
            <items code="at0005">
                <items id="text">Arzneimittel wurde neu bewertet</items>
                <items id="description">Das individuelle Arzneimittel wurde neu bewertet, beispielsweise ob das Arzneimittel noch angewendet werden soll. Eine Überprüfung der Arzneimittelliste soll nicht durchgeführt werden.</items>
            </items>
            <items code="at0006">
                <items id="text">Dosis wurde verabreicht</items>
                <items id="description">Eine einzelne Verabreichung des Arzneimittels ist erfolgt.</items>
            </items>
            <items code="at0007">
                <items id="text">Verordnung abgeschlossen</items>
                <items id="description">Die medikamentöse Behandlung wurde, wie geplant, beendet.</items>
            </items>
            <items code="at0008">
                <items id="text">Verzögerung der Rezeptabgabe</items>
                <items id="description">Das Rezept wurde aufgrund einer technischen oder pharmazeutischen Störung nicht ausgegeben.</items>
            </items>
            <items code="at0009">
                <items id="text">Verordnung pausiert</items>
                <items id="description">Die Verabreichung des Arzneimittels wurde bis zum Erhalt weiterer Informationen ausgesetzt. Es sollten keine weiteren Dosen, bis zur Bekanntgabe des neuen Startdatums oder bis die Bedingungen erfüllt sind, verabreicht werden. Wenn Sie das Datum/ die Voraussetzungen für den Neustart nach dem Aussetzen festlegen, sollte ein Schritt von "Verabreichung wurde ausgesetzt" und zurück zu "Arzneimittel Startdatum/Voraussetzung" ausgeführt werden.</items>
            </items>
            <items code="at0010">
                <items id="text">Rezept neu ausgestellt</items>
                <items id="description">Ein Rezept wurde für eine vorhandene Arzneimittelverordnung neu ausgestellt.</items>
            </items>
            <items code="at0011">
                <items id="text">Re-Autorisierug des Rezepts ausstehend</items>
                <items id="description">Die Ausstellung des Rezeptes wartet auf die erneute Autorisierung durch einen Arzt.</items>
            </items>
            <items code="at0012">
                <items id="text">Arzneimittelbehandlung wurde abgesagt</items>
                <items id="description">Die geplante Arzneimittelbehandlung wurde vor der Verabreichung abgesagt.</items>
            </items>
            <items code="at0013">
                <items id="text">Arzneimittelbehandlung wurde verschoben</items>
                <items id="description">Die geplante Arzneimittelbehandlung wurde vor der Verabreichung verschoben.</items>
            </items>
            <items code="at0015">
                <items id="text">Verordnung gestoppt</items>
                <items id="description">Die Verabreichung des Arzneimittels wurde während der Dauer der geplanten Behandlung eingestellt.</items>
            </items>
            <items code="at0016">
                <items id="text">Arzneimittel Startdatum/Voraussetzung</items>
                <items id="description">Das Startdatum der Arzneimittelanwendung oder andere Startbedingungen wurden festgelegt.</items>
            </items>
            <items code="at0017">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0018">
                <items id="text">Verabreichung einer Dosis wurde ausgelassen</items>
                <items id="description">Eine Gabe des Arzneimittels wurde zurückgehalten und nicht gegeben. Es besteht keine Erwartung, dass sie später verabreicht wird, obwohl die nächste Dosis (falls es eine gibt) gemäß der ursprünglichen Verordnung verabreicht werden sollte.</items>
            </items>
            <items code="at0020">
                <items id="text">Arzneimittel</items>
                <items id="description">Name des Arzneimittels, eines Impfstoffs oder eines anderen therapeutischen Mittels, welches im Mittelpunkt der Aktivität steht.</items>
                <items id="comment">Zum Beispiel: "Atenolol 100 mg" oder "Tenormin Tabletten 100 mg".
Es wird dringend empfohlen, dass das Element "Arzneimittel" mit einer Terminologie kodiert wird, die nach Möglichkeit eine Entscheidungsunterstützung auslösen kann. Der Umfang der Kodierung kann vom einfachen Namen des Arzneimittels bis hin zu strukturierten Details über die tatsächlich verwendete Medikamentenpackung variieren. Die Freitext-Eingabe sollte nur dann verwendet werden, wenn keine entsprechende Terminologie vorhanden ist.</items>
            </items>
            <items code="at0021">
                <items id="text">Begründung</items>
                <items id="description">Begründung, warum der Prozessschritt für das identifizierte Arzneimittel durchgeführt wurde.</items>
                <items id="comment">Zum Beispiel: "Verschoben - Patient zur Verabreichungszeit nicht verfügbar", "abgesagt - Nebenwirkung". Merke: Dies ist nicht der Grund für die Verordnung von Arzneimittel, sondern der spezifische Grund, warum ein Prozessschritt durchgeführt wurde. Wird oft verwendet, um Abweichungen von der ursprünglichen Verordnung zu dokumentieren.</items>
            </items>
            <items code="at0024">
                <items id="text">Kommentar</items>
                <items id="description">Zur Dokumentation von zusätzlichen Schilderungen über die Aktivitäten oder den Prozessschritt, wenn sie noch nicht in anderen Feldern erfasst wurden. Dabei sollen Einzelheiten zu Abweichungen zwischen durchzuführender Aktion und tatsächlich durchgeführter Aktion erfasst werden.</items>
                <items id="comment">Zum Beispiel: "Patient war in der Radiologie.", "Versehentliche Punktion der Vene während der i.m. Verabreichung."</items>
            </items>
            <items code="at0025">
                <items id="text">Sequenznummer</items>
                <items id="description">Die spezifische Sequenznummer des Prozessschritts wird erfasst.</items>
                <items id="comment">Zum Beispiel: Impfsequenznummer.</items>
            </items>
            <items code="at0030">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0033">
                <items id="text">Patientenanweisung</items>
                <items id="description">Jede Anweisung, Anleitung oder Empfehlung, die dem Patienten oder der Pflegekraft zum Zeitpunkt eines Prozessschrittes übermittelt wird.</items>
                <items id="comment">Zum Beispiel: "Vermeiden Sie den Konsum von Grapefruits oder grapefruithaltigen Lebensmitteln.", "Die Einnahme sollte mindestens 2 Stunden vor dem Zubettgehen erfolgen.", "Bitte zusammen mit Nahrung einnehmen." Wenn es klinisch zutreffend ist, kann für dieses Item eine Terminologie hinterlegt werden.</items>
            </items>
            <items code="at0039">
                <items id="text">Grosse Änderung der Verordnung</items>
                <items id="description">Eine große Änderung der Verordnung war erforderlich, die dazu führte, dass diese Verordnung gestoppt und eine Ersatzverordnung gestartet wurde.</items>
            </items>
            <items code="at0041">
                <items id="text">Geringfügige Änderung der Verordnung</items>
                <items id="description">Die Arzneimittelverordnung wurde so geändert, dass keine neue Verordnung/neues Rezept nach den lokalen klinischen Regeln ausgestellt werden muss.</items>
            </items>
            <items code="at0043">
                <items id="text">Ursprünglich geplantes Datum/Uhrzeit</items>
                <items id="description">Das Datum/die Uhrzeit, an dem die Aktion mit dem Arzneimittel eingeplant war.</items>
                <items id="comment">Wird verwendet, um die Abweichung von der tatsächlichen Aktionszeit zu vergleichen, wenn diese aus der ursprünglichen Verordnung nicht leicht berechenbar ist.</items>
            </items>
            <items code="at0044">
                <items id="text">Verabreichung einer Dosis wurde verschoben</items>
                <items id="description">Die Verabreichung einer Dosis hat sich verzögert, wird aber so schnell wie möglich erfolgen.</items>
            </items>
            <items code="at0053">
                <items id="text">Zusätzliche Details</items>
                <items id="description">Weitere strukturierte Details zu der Aktivität, möglicherweise speziell zu einem Prozessschritt.</items>
            </items>
            <items code="at0085">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0103">
                <items id="text">Verordnungsgruppierung-ID</items>
                <items id="description">UID einer Medikamentenverordnungsgruppierung, zu dem die Verordnung gehört. Eine Verordnung kann Teil von mehreren Gruppierungen gleichzeitig sein.</items>
                <items id="comment">Medikamentenverordnungsgruppierungen helfen beim Verwalten mehrerer Verordnungen, die gemeinsam begonnen/beendet werden sollen, z.B. im Post-OP Aufwachraum.</items>
            </items>
            <items code="at0104">
                <items id="text">Arzneimitteldetails</items>
                <items id="description">Strukturierte Informationen über das Arzneimittel inklusive Stärke, Form und Inhaltsstoffe.</items>
                <items id="comment">Verwenden Sie diesen SLOT, wenn die detaillierte Beschreibung des ausgegebenen, autorisierten oder verabreichten Arzneimittels ausdrücklich angegeben werden muss. Zum Beispiel: die Form, Stärke, alle Verdünner oder Mischung von Inhaltsstoffen.</items>
            </items>
            <items code="at0106">
                <items id="text">Rezept ist re-autorisiert</items>
                <items id="description">Die ursprüngliche Verordnung des Arzneimittels wurde erneut genehmigt, um eine wiederholte Verschreibung oder Abgabe zu ermöglichen. In einigen Ländern, wie z.B. Deutschland, muss unter diesen Umständen ein völlig neues Rezept ausgestellt werden.</items>
            </items>
            <items code="at0109">
                <items id="text">Arzneimittel empfohlen</items>
                <items id="description">Das Arzneimittel wurde empfohlen, aber es wurden keine Schritte unternommen, um die Verschreibung/Verordnung einzuleiten.</items>
            </items>
            <items code="at0131">
                <items id="text">Dosis</items>
                <items id="description">Spezifische Angaben zur Dosis des Arzneimittels.</items>
                <items id="comment">Der CLUSTER.dosage soll Details zu Änderungen der Arzneimittelverordnung oder der Dosisverabreichungen enthalten, während CLUSTER.medication_supply_amount ist für Details zu Aktivitäten im Zusammenhang mit der Abgabe bestimmt.</items>
            </items>
            <items code="at0132">
                <items id="text">Substitution</items>
                <items id="description">Substitutionsmaßnahmen, die von der Person ergriffen werden, die das Medikament verabreicht oder ausgibt.</items>
                <items id="comment">In vielen Rechtssystemen ist die Substitution eines verordneten Arzneimittels in generischer Form oder mit einem anderen Markennamen, welcher als bioäquivalent bestimmt wurde, zum Zeitpunkt der Ausgabe oder Verabreichung erlaubt. In anderen Fällen wird eine Substitution erwartet und der Arzt muss ausdrücklich die Nicht-Substitution verlangen.</items>
            </items>
            <items code="at0133">
                <items id="text">Grund für die Substitution</items>
                <items id="description">Die Ursache oder die Begründung für die durchgeführte Substitution.</items>
                <items id="comment">Zum Beispiel: "Generische Alternative beinhaltet eine Substanz, die vom Patient nicht vertragen wird." Kann bei klinischer Eignung mit einer Terminologie codiert werden.</items>
            </items>
            <items code="at0138">
                <items id="text">Substitution wurde durchgeführt</items>
                <items id="description">Ein Arzneimittel wurde substituiert, welches bioäquivalent zu dem Angeforderten ist.</items>
            </items>
            <items code="at0139">
                <items id="text">Substitution wurde nicht durchgeführt</items>
                <items id="description">Obwohl es nach der Arzneimittelverordnung erlaubt gewesen wäre, wurde nicht mit einem bioäquivalenten Arzneimittel substituiert.</items>
            </items>
            <items code="at0140">
                <items id="text">Details zur Verabreichung</items>
                <items id="description">Details über die Körperstelle und über die Verabreichung des Arzneimittels.</items>
            </items>
            <items code="at0141">
                <items id="text">Körperstelle</items>
                <items id="description">Strukturierte Beschreibung der Körperstelle, an der das Arzneimittel angewendet wird.</items>
                <items id="comment">Zum Beispiel: "linker Oberarm", "intravenöser Katheter rechte Hand". Die Codierung der Körperstelle mit einer Terminologie, wenn möglich, wird bevorzugt.</items>
            </items>
            <items code="at0142">
                <items id="text">Lokalisation</items>
                <items id="description">Genaue Beschreibung der Körperstelle, an der das Arzneimittel, der Impfstoff oder ein therapeutisches Produkt angewendet wird.</items>
                <items id="comment">Zum Beispiel: "Auf der medialen Hautoberfläche des linken Unterarms, 10 cm bis 20 cm distal von der Spitze des Ellbogens entfernt."</items>
            </items>
            <items code="at0143">
                <items id="text">Methode der Verabreichung</items>
                <items id="description">Die Technik oder das Gerät mit dem das verschriebene Arzneimittel verabreicht wird oder werden soll.</items>
                <items id="comment">Kommentar: Zum Beispiel: "via Z-track Injektion"; "via Vernebler". Die Codierung der Methode mit einer Terminologie, wenn möglich, wird bevorzugt.</items>
            </items>
            <items code="at0144">
                <items id="text">Verabreichungsmittel</items>
                <items id="description">Details zu der Vorrichtung mit dem das Arzneimittel verabreicht wird.</items>
            </items>
            <items code="at0145">
                <items id="text">Rezept wartet auf Genehmigung</items>
                <items id="description">Der Rezeptentwurf wurde erstellt und wartet auf die Bestätigung durch einen autorisierten Arzt. Kann auch verwendet werden, wenn die Re-autorisierung gebündelt erfolgt. Dieser "careflow_step" hat den Status "geplant" oder "aktiv", was die Notwendigkeit widerspiegelt, sowohl Neuaufträge als auch erneut autorisierte Aufträge zu bearbeiten.</items>
            </items>
            <items code="at0147">
                <items id="text">Verabreichungsweg</items>
                <items id="description">Die Angabe darüber, auf welche Art das verordnete Arzneimittel am Körper des Patienten angewendet wird.</items>
                <items id="comment">Kommentar: Zum Beispiel: "oral", "intravenös" oder "topisch". Die Codierung des Verabreichungswegs wird bevorzugt, wenn möglich. Mehrere potentielle Anwendungsformen können spezifiziert werden.</items>
            </items>
            <items code="at0148">
                <items id="text">Arzneimittel wurde vorbereitet</items>
                <items id="description">*The medication has been physically prepared. (en)</items>
                <items id="comment">*For example: preparation of an intravenous mixture. (en)</items>
            </items>
            <items code="at0149">
                <items id="text">Nachkontrolliert?</items>
                <items id="description">Der Prozessschritt wurde durch eine unabhängige Person überprüft.</items>
                <items id="comment">Details zu der Person, die die Überprüfung vornimmt, können in das Referenzmodell "Participations" übertragen werden.</items>
            </items>
            <items code="at0150">
                <items id="text">Verordnung gelöscht</items>
                <items id="description">Das Rezept wurde vor der Ausstellung widerrufen.</items>
            </items>
            <items code="at0151">
                <items id="text">Rezept ist ungültig oder abgelaufen</items>
                <items id="description">Das Rezept ist ungültig geworden oder ist abgelaufen, ohne das es eingelöst wurde.</items>
            </items>
            <items code="at0152">
                <items id="text">Rezept wurde ausgeführt</items>
                <items id="description">Das Rezept wurde erfolgreich ausgeführt/eingehalten.</items>
            </items>
            <items code="at0153">
                <items id="text">Arzneimittel wurde genehmigt</items>
                <items id="description">Das Arzneimittel ist offiziell zur Anwendung genehmigt.</items>
            </items>
            <items code="at0154">
                <items id="text">Datum/Uhrzeit des Neustarts</items>
                <items id="description">Das Datum/die Uhrzeit an dem die Arzneimittelbehandlung wieder begonnen wird, gemäß dem "Verabreichung wurde ausgesetzt"- Schritt.</items>
                <items id="comment">Zum Beispiel: 29.10.2017</items>
            </items>
            <items code="at0155">
                <items id="text">Kriterium des Neustarts</items>
                <items id="description">Das Kriterium, das den Neustart der Arzneimittelbehandlung auslöst, gemäß dem Schritt "Verabreichung wurde ausgesetzt".</items>
                <items id="comment">Zum Beispiel: "Am Tag 2 nach der OP."</items>
            </items>
            <items code="at0156">
                <items id="text">Klinische Indikation</items>
                <items id="description">Der klinische Grund für die Aktivität mit dem Arzneimittel.</items>
                <items id="comment">Zum Beispiel: "Angina" oder "Schmerz". Die Codierung der Indikation mit einer Terminologie wird nach Möglichkeit bevorzugt. Dieses Datenelement ermöglicht mehrere Vorkommen. Wenn nur ein AKTION-Archetyp zur Aufzeichnung einer Medikamentenindikation verwendet wird, kann dieses Datenelement ohne zusätzliche Überlegungen verwendet werden. Wenn jedoch eine klinische Indikation sowohl im INSTRUCTION-Archetyp zur Verordnung von Arzneimittel als auch im AKTION-Archetyp zur Medikamentenanwendung aufgezeichnet wird, beachten Sie, dass diese Indikationen möglicherweise nicht konsistent sind.</items>
            </items>
            <items code="at0157">
                <items id="text">*Medication double checked (en)</items>
                <items id="description">*The prepared medication has been double checked. (en)</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">*Medication management (en)</items>
                <items id="description">*Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item. (en)</items>
                <items id="comment">*This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication. (en)</items>
            </items>
            <items code="at0002">
                <items id="text">*Prescription issued (en)</items>
                <items id="description">*A prescription has been issued for the medication. (en)</items>
            </items>
            <items code="at0003">
                <items id="text">*Prescription dispensed (en)</items>
                <items id="description">*The ordered medication has been dispensed, for example from a pharmacy to the patient. (en)</items>
            </items>
            <items code="at0004">
                <items id="text">*Medication course commenced (en)</items>
                <items id="description">*The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">*Medication reassessed (en)</items>
                <items id="description">*The individual medication has been reassessed, for example whether the medication should still be taken. This is not intended to capture review of the medication list. (en)</items>
            </items>
            <items code="at0006">
                <items id="text">*Dose administered (en)</items>
                <items id="description">*A single administration of the medication has taken place. (en)</items>
            </items>
            <items code="at0007">
                <items id="text">*Medication course completed (en)</items>
                <items id="description">*The medication course has been completed as planned. (en)</items>
            </items>
            <items code="at0008">
                <items id="text">*Prescription supply delayed (en)</items>
                <items id="description">*The prescription has not been dispensed due to a technical or pharamaceutical supply issue. (en)</items>
            </items>
            <items code="at0009">
                <items id="text">*Administrations suspended (en)</items>
                <items id="description">*The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed. (en)</items>
            </items>
            <items code="at0010">
                <items id="text">*Prescription re-issued (en)</items>
                <items id="description">*A prescription has been re-issued for an existing medication order. (en)</items>
            </items>
            <items code="at0011">
                <items id="text">*Prescription re-authorisation pending (en)</items>
                <items id="description">*Issue of the prescription is awaiting re-authorisation by a clinician. (en)</items>
            </items>
            <items code="at0012">
                <items id="text">*Medication course cancelled (en)</items>
                <items id="description">*The planned course of medication has been cancelled prior to any administration. (en)</items>
            </items>
            <items code="at0013">
                <items id="text">*Medication course postponed (en)</items>
                <items id="description">*The scheduled medication course has been postponed prior to any administration. (en)</items>
            </items>
            <items code="at0015">
                <items id="text">*Medication course stopped (en)</items>
                <items id="description">*Administration of the medication has been ceased during the period of the intended course. (en)</items>
            </items>
            <items code="at0016">
                <items id="text">*Medication start date/condition set (en)</items>
                <items id="description">*The time to start the medication, or other starting condition, has been set. (en)</items>
            </items>
            <items code="at0017">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0018">
                <items id="text">*Dose administration omitted (en)</items>
                <items id="description">*An administration of the medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order. (en)</items>
            </items>
            <items code="at0020">
                <items id="text">*Medication item (en)</items>
                <items id="description">*Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity. (en)</items>
                <items id="comment">*For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. 
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available. (en)</items>
            </items>
            <items code="at0021">
                <items id="text">*Reason (en)</items>
                <items id="description">*Reason that the pathway step for the identified medication was carried out. (en)</items>
                <items id="comment">*For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order. (en)</items>
            </items>
            <items code="at0024">
                <items id="text">*Comment (en)</items>
                <items id="description">*Additional narrative about the activity or pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed. (en)</items>
                <items id="comment">*For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'. (en)</items>
            </items>
            <items code="at0025">
                <items id="text">*Sequence number (en)</items>
                <items id="description">*The sequence number specific to the pathway step being recorded. (en)</items>
                <items id="comment">*For example: Vaccine sequence number. (en)</items>
            </items>
            <items code="at0030">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0033">
                <items id="text">*Patient guidance (en)</items>
                <items id="description">*Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step. (en)</items>
                <items id="comment">*For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate. (en)</items>
            </items>
            <items code="at0039">
                <items id="text">*Major change to order (en)</items>
                <items id="description">*A major change to the order was required, resulting in this order being stopped and a replacement order being started. (en)</items>
            </items>
            <items code="at0041">
                <items id="text">*Minor change to order (en)</items>
                <items id="description">*The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules. (en)</items>
            </items>
            <items code="at0043">
                <items id="text">*Original scheduled date/time (en)</items>
                <items id="description">*The datetime at which the medication action was scheduled to occur. (en)</items>
                <items id="comment">*Used to compare variance from actual action time where this is not readily calculable from the original instruction. (en)</items>
            </items>
            <items code="at0044">
                <items id="text">*Dose administration deferred (en)</items>
                <items id="description">*An administration of a dose of the medication has been delayed but is expected to be given as soon as possible. (en)</items>
            </items>
            <items code="at0053">
                <items id="text">*Additional details (en)</items>
                <items id="description">*Further structured details of the action, possibly specific to a pathway step. (en)</items>
            </items>
            <items code="at0085">
                <items id="text">*Extension (en)</items>
                <items id="description">*Additional information required to capture local content or to align with other reference models/formalisms. (en)</items>
                <items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents. (en)</items>
            </items>
            <items code="at0103">
                <items id="text">*Order ID (en)</items>
                <items id="description">*Unique identifier for the medication order. (en)</items>
                <items id="comment">*Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required. (en)</items>
            </items>
            <items code="at0104">
                <items id="text">*Medication details (en)</items>
                <items id="description">*Structured details about the medication including strength, form and constituent substances. (en)</items>
                <items id="comment">*Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients. (en)</items>
            </items>
            <items code="at0106">
                <items id="text">*Prescription re-authorised (en)</items>
                <items id="description">*The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances. (en)</items>
            </items>
            <items code="at0109">
                <items id="text">*Medication recommended (en)</items>
                <items id="description">*The medication has been recommended but no steps have been taken to initiate prescribing. (en)</items>
            </items>
            <items code="at0131">
                <items id="text">*Amount (en)</items>
                <items id="description">*Specific details about the amount of the medication item. (en)</items>
                <items id="comment">*CLUSTER.dosage is intended to carry details of medication order changes or dose administrations, whilst CLUSTER.medication_supply_amount is intended for details of dispensing-related activity. (en)</items>
            </items>
            <items code="at0132">
                <items id="text">*Substitution (en)</items>
                <items id="description">*Subsitution action taken by the person administering or dispensing the drug. (en)</items>
                <items id="comment">*In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution. (en)</items>
            </items>
            <items code="at0133">
                <items id="text">*Substitution reason (en)</items>
                <items id="description">*The reason or justification for the substitution action taken. (en)</items>
                <items id="comment">*For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate (en)</items>
            </items>
            <items code="at0138">
                <items id="text">*Substitution performed (en)</items>
                <items id="description">*A medication was substituted which is bioequivalent to that ordered. (en)</items>
            </items>
            <items code="at0139">
                <items id="text">*Substitution not performed (en)</items>
                <items id="description">*Although allowed by the medication order a bioequvalent medication was not substituted. (en)</items>
            </items>
            <items code="at0140">
                <items id="text">*Administration details (en)</items>
                <items id="description">*Details of body site and administration of the medication. (en)</items>
            </items>
            <items code="at0141">
                <items id="text">*Body site (en)</items>
                <items id="description">*Structured description of the site of administration of the ordered item. (en)</items>
                <items id="comment">*For example: 'left upper arm', 'intravenous catheter right hand'. 
Coding of the body site with a terminology is preferred, where possible. (en)</items>
            </items>
            <items code="at0142">
                <items id="text">*Structured body site (en)</items>
                <items id="description">*Structured description of the site of administration of the medication, vaccine or therapeutic good. (en)</items>
                <items id="comment">*For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow". (en)</items>
            </items>
            <items code="at0143">
                <items id="text">*Administration method (en)</items>
                <items id="description">*The technique or device by which the ordered item was, or is to be, administered. (en)</items>
                <items id="comment">*Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible. (en)</items>
            </items>
            <items code="at0144">
                <items id="text">*Administration device (en)</items>
                <items id="description">*Details of the medical device used to assist administration of the medication. (en)</items>
            </items>
            <items code="at0145">
                <items id="text">*Prescription awaiting authorisation (en)</items>
                <items id="description">*Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders. (en)</items>
            </items>
            <items code="at0147">
                <items id="text">*Route (en)</items>
                <items id="description">*The route by which the ordered item was, or is to be, administered into the subject's body. (en)</items>
                <items id="comment">*Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified. (en)</items>
            </items>
            <items code="at0148">
                <items id="text">*Medication prepared (en)</items>
                <items id="description">*The medication has been physically prepared. (en)</items>
                <items id="comment">*For example: preparation of an intravenous mixture. (en)</items>
            </items>
            <items code="at0149">
                <items id="text">*Double-checked? (en)</items>
                <items id="description">*The pathway step has been checked by a separate individual. (en)</items>
                <items id="comment">*Details of the individual performing the double-check can be carried in the Reference Model element "Participation". (en)</items>
            </items>
            <items code="at0150">
                <items id="text">*Prescription cancelled (en)</items>
                <items id="description">*The prescription was cancelled prior to being issued. (en)</items>
            </items>
            <items code="at0151">
                <items id="text">*Prescription invalid or expired (en)</items>
                <items id="description">*Prescription has been invalidated or has expired without being fulfilled. (en)</items>
            </items>
            <items code="at0152">
                <items id="text">*Prescription fulfilled (en)</items>
                <items id="description">*The prescription has been fulfilled successfully. (en)</items>
            </items>
            <items code="at0153">
                <items id="text">*Medication authorised (en)</items>
                <items id="description">*The medication has been formally authorised for use. (en)</items>
            </items>
            <items code="at0154">
                <items id="text">*Restart date/time (en)</items>
                <items id="description">*The date/time on which the medication course is set to restart, as per the "Administrations suspended" pathway step. (en)</items>
                <items id="comment">*For example: 2017-10-29 (en)</items>
            </items>
            <items code="at0155">
                <items id="text">*Restart criterion (en)</items>
                <items id="description">*The criterion which triggers the medication course to restart, as per the "Administrations suspended" pathway step. (en)</items>
                <items id="comment">*For example: "On day 2 after surgery". (en)</items>
            </items>
            <items code="at0156">
                <items id="text">*Clinical indication (en)</items>
                <items id="description">*The clinical reason for the medication activity. (en)</items>
                <items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items>
            </items>
            <items code="at0157">
                <items id="text">*Medication double checked (en)</items>
                <items id="description">*The prepared medication has been double checked. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.device.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Installation</items>
                <items id="description">Ein Instrument, ein Gerät, ein Implantat, ein Material oder ähnliches, das für die Bereitstellung von Gesundheitsleistungen verwendet wird. In diesem Zusammenhang umfasst ein medizinisches Gerät eine breite Palette von Geräten, die auf verschiedene physikalische, mechanische, thermische oder ähnliche Weise wirken, schließt jedoch insbesondere Geräte aus, die auf medizinischem Wege wirken, wie zum Beispiel pharmakologische, metabolische oder immunologische Methoden. Der Geltungsbereich umfasst Einweggeräte sowie langlebige oder dauerhafte Geräte, die nachverfolgt, gewartet oder regelmäßig kalibriert werden müssen, wobei zu berücksichtigen ist, dass für jeden Gerätetyp bestimmte Datenaufzeichnungsanforderungen gelten.</items>
                <items id="comment">In diesem Use Case das Medizingerät bzw. die Installation, welche bei der Verabreichung unterstützen soll oder durch welche das Arzneimittel verabreicht werden soll.</items>
            </items>
            <items code="at0001">
                <items id="text">Gerätename</items>
                <items id="description">Identifizierung des Medizingerätes, bevorzugt durch einen allgemein
gebräuchlichen Namen, einer formellen und vollständig beschreibenden Bezeichnung oder falls notwendig anhand einer Klasse oder Kategorie des Gerätes.</items>
                <items id="comment">Dieses Datenelement erfasst den Begriff, die Phrase oder die Kategorie, die in der klinischen Praxis verwendet werden. Zum Beispiel: &lt;Markenname&gt; &lt;Maschine&gt; (XYZ-Audiometer); &lt;Markenname&gt; (14G Jelco IV-Katheter); oder &lt;Markenname / Typ&gt; &lt;Implantat&gt;. Die Codierung mit einer Terminologie ist nach Möglichkeit wünschenswert, auch wenn dies lokal sein kann und von den verfügbaren lokalen Lieferungen abhängt.</items>
            </items>
            <items code="at0002">
                <items id="text">Beschreibung</items>
                <items id="description">Beschreibung des Medizingerätes.</items>
            </items>
            <items code="at0003">
                <items id="text">Gerätetyp</items>
                <items id="description">Die Kategorie des Medizingeräts.</items>
                <items id="comment">Nicht zutreffend, wenn eine Kategorie bereits unter "Gerätename" dokumentiert ist. 
Beispiel: Wenn das 'Gerät' als 'Harnkatheter' bezeichnet wird; der 'Typ' kann als 'Verweilkatheter' oder 'Kondom' aufgezeichnet werden. Die Codierung mit einer Terminologie ist wünschenswert, sofern dies möglich ist. Dies kann die Verwendung von GTIN- oder EAN-Nummern einschließen.</items>
            </items>
            <items code="at0004">
                <items id="text">Hersteller</items>
                <items id="description">Name des Herstellers.</items>
            </items>
            <items code="at0005">
                <items id="text">Herstellungsdatum</items>
                <items id="description">Herstellungsdatum des Gerätes.</items>
            </items>
            <items code="at0006">
                <items id="text">Chargennummer</items>
                <items id="description">Die vom Hersteller zugewiesene Nummer, die eine Gruppe von gleichzeitig hergestellten Artikeln kennzeichnet, die sich normalerweise auf dem Etikett oder dem Verpackungsmaterial befindet.</items>
            </items>
            <items code="at0007">
                <items id="text">Ablaufdatum</items>
                <items id="description">Das Datum, ab dem das Gerät/Produkt nicht mehr einsatzfähig ist. Wird normalerweise auf dem Gerät selbst oder auf der beiliegenden Verpackung aufgedruckt.</items>
                <items id="comment">Dieses Datum gilt normalerweise nur für Einmalprodukte oder Einwegprodukte.</items>
            </items>
            <items code="at0008">
                <items id="text">Kommentar</items>
                <items id="description">Informationen, die hier nicht strukturiert erfasst wurden.</items>
            </items>
            <items code="at0009">
                <items id="text">Eigenschaften</items>
                <items id="description">Weitere Details zu bestimmten Eigenschaften des Medizingerätes.</items>
            </items>
            <items code="at0018">
                <items id="text">Komponenten</items>
                <items id="description">Zusätzliche strukturierte Informationen zu identifizierten Komponenten des Geräts.</items>
            </items>
            <items code="at0019">
                <items id="text">Geräteverwaltung</items>
                <items id="description">Weitere Details zur Verwaltung und Wartung des Geräts.</items>
                <items id="comment">Zum Beispiel: Eigentümer, Kontaktdaten, Standort, Netzwerkadresse, Ersetzungsdatum, Kalibrierungsdetails usw.</items>
            </items>
            <items code="at0020">
                <items id="text">Seriennummer</items>
                <items id="description">Die vom Hersteller zugewiesene Nummer, die sich auf dem Gerät befindet, muss für jedes Gerät, sein Etikett oder die dazugehörige Verpackung spezifisch sein.</items>
            </items>
            <items code="at0021">
                <items id="text">Eindeutige Identifikationsnummer (ID)</items>
                <items id="description">Eine numerische oder alphanumerische Zeichenfolge, die diesem Gerät in einem bestimmten System zugeordnet ist.

</items>
                <items id="comment">Oft als Barcode am Gerät befestigt.</items>
            </items>
            <items code="at0022">
                <items id="text">Katalognummer</items>
                <items id="description">Die genaue vom Hersteller vergebene Nummer, wie sie im Herstellerkatalog, in der Gerätekennzeichnung oder in der Begleitverpackung angegeben ist.</items>
            </items>
            <items code="at0023">
                <items id="text">Modellnummer</items>
                <items id="description">Die Modellnummer des Herstellers, die sich auf dem Geräteetikett oder der zugehörigen Verpackung befindet.</items>
            </items>
            <items code="at0024">
                <items id="text">Weitere ID</items>
                <items id="description">Nicht spezifizierter Bezeichner, der in einer Vorlage oder zur Laufzeit weiter spezifiziert werden kann.</items>
                <items id="comment">Sofern verfügbar, ist die Kodierung des Namens des Identifikators mit einem Kodierungssystem wünschenswert.</items>
            </items>
            <items code="at0025">
                <items id="text">Softwareversion</items>
                <items id="description">Identifizierung der im Medizingerät verwendeten Softwareversion.</items>
                <items id="comment">Wenn das Medizinprodukt eine eigentliche Softwareanwendung ist, erfassen Sie die Version der Software mit diesem Datenelement. Wenn in dem Medizingerät mehrere Softwareanwendungen eingebettet sind, zeichnen Sie jede Softwarekomponente in einem separaten CLUSTER-Archetyp im 
Komponenten-SLOT auf - entweder als verschachtelte Instanz eines
anderen CLUSTER.device-Archetyps oder unter Verwendung eines
CLUSTER-Archetyps, der speziell für die Aufzeichnung von
Softwaredetails entwickelt wurde (aber zum Zeitpunkt dieser
Archetypentwicklung noch nicht verfügbar war).</items>
            </items>
            <items code="at0026">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen, die zur Erfassung des lokalen Kontexts oder
zur Angleichung an andere Referenzmodelle/Formalismen erforderlich sind.</items>
            </items>
            <items code="at0027">
                <items id="text">Multimedia</items>
                <items id="description">Digitale Repräsentation des Gerätes.</items>
                <items id="comment">Zum Beispiel: ein technisches Diagramm eines Geräts oder ein digitales Bild.</items>
            </items>
            <items code="SNOMED-CT::257369004">
                <items id="text">Single lumen tube</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">Dispositif médical</items>
                <items id="description">Un instrument, un appareil, un implant, un matériau ou similaire, utilisé dans la prestation de soins de santé. Dans ce contexte, un dispositif médical comprend un large éventail de dispositifs qui agissent par divers moyens physiques, mécaniques, thermiques ou similaires, mais exclut spécifiquement les dispositifs qui agissent par des moyens médicinaux tels que les méthodes pharmacologiques, métaboliques ou immunologiques. Le champ d'application comprend les dispositifs jetables ainsi que les dispositifs durables ou persistants qui nécessitent un suivi, des activités de maintenance ou un étalonnage régulier, en reconnaissant que chaque type de dispositif a des exigences spécifiques en matière d'enregistrement des données.</items>
            </items>
            <items code="at0001">
                <items id="text">Nom de l'appareil</items>
                <items id="description">Identification du dispositif médical, de préférence par un nom commun, un nom formel entièrement descriptif ou, si nécessaire, par classe ou catégorie de dispositif.</items>
                <items id="comment">Cet élément de données permet de saisir le terme, la phrase ou la catégorie utilisés dans la pratique clinique. Par exemple : &lt;brand name&gt;&lt;machine&gt; (Audiomètre XYZ) ; &lt;taille&gt; &lt;brand name&gt; (cathéter IV Jelco 14G) ; ou &lt;brand name/type&gt; &lt;implant&gt;. Il est souhaitable de coder avec une terminologie, dans la mesure du possible, bien que celle-ci puisse être locale et dépendre des fournitures locales disponibles.</items>
            </items>
            <items code="at0002">
                <items id="text">Description</items>
                <items id="description">Description narrative du dispositif médical.</items>
            </items>
            <items code="at0003">
                <items id="text">Type</items>
                <items id="description">La catégorie ou le type de dispositif.</items>
                <items id="comment">Non applicable si une catégorie est déjà enregistrée dans "Nom du dispositif".
 Exemple : si le "dispositif" est nommé "sonde urinaire", le "type" peut être enregistré comme "à demeure" ou "préservatif". Il est souhaitable, dans la mesure du possible, de coder avec une terminologie. Cela peut inclure l'utilisation de numéros GTIN ou EAN.</items>
            </items>
            <items code="at0004">
                <items id="text">Fabricant</items>
                <items id="description">Nom du fabricant</items>
            </items>
            <items code="at0005">
                <items id="text">Date de fabrication</items>
                <items id="description">Date de fabrication de l'appareil.</items>
            </items>
            <items code="at0006">
                <items id="text">Numéro de lot</items>
                <items id="description">Le numéro attribué par le fabricant qui identifie un groupe d'articles fabriqués en même temps, généralement sur l'étiquette ou le matériel d'emballage.</items>
            </items>
            <items code="at0007">
                <items id="text">Date d'expiration</items>
                <items id="description">Date après laquelle le dispositif/produit n'est plus apte à être utilisé, généralement indiquée sur le dispositif lui-même ou imprimée sur l'emballage qui l'accompagne.</items>
                <items id="comment">Cette date ne s'applique généralement qu'aux dispositifs à usage unique ou jetables.</items>
            </items>
            <items code="at0008">
                <items id="text">Commentaire</items>
                <items id="description">Informations supplémentaires sur l'appareil qui n'ont pas été saisies dans d'autres champs.</items>
            </items>
            <items code="at0009">
                <items id="text">Propriétés</items>
                <items id="description">Détails supplémentaires sur les propriétés spécifiques du dispositif médical.</items>
            </items>
            <items code="at0018">
                <items id="text">Composants</items>
                <items id="description">Informations structurées supplémentaires sur les composants identifiés de l'appareil.</items>
            </items>
            <items code="at0019">
                <items id="text">Gestion des actifs</items>
                <items id="description">Plus de détails sur la gestion et l'entretien de l'appareil.</items>
                <items id="comment">Par exemple : Propriétaire, coordonnées, emplacement, adresse réseau, date de remplacement, détails d'étalonnage, etc.</items>
            </items>
            <items code="at0020">
                <items id="text">Numéro de série</items>
                <items id="description">Numéro attribué par le fabricant qui se trouve sur le dispositif et qui doit être spécifique à chaque dispositif, à son étiquette ou à l'emballage qui l'accompagne.</items>
            </items>
            <items code="at0021">
                <items id="text">Identifiant unique de l'appareil (UDI)</items>
                <items id="description">Chaîne numérique ou alphanumérique associée à ce dispositif dans un système donné.</items>
                <items id="comment">Souvent fixé à l'appareil sous la forme d'un code-barres.</items>
            </items>
            <items code="at0022">
                <items id="text">Numéro de catalogue</items>
                <items id="description">Le numéro exact attribué par le fabricant, tel qu'il apparaît dans le catalogue du fabricant, l'étiquetage de l'appareil ou l'emballage qui l'accompagne.</items>
            </items>
            <items code="at0023">
                <items id="text">Numéro de modèle</items>
                <items id="description">Le numéro de modèle exact attribué par le fabricant et figurant sur l'étiquette de l'appareil ou sur l'emballage qui l'accompagne.</items>
            </items>
            <items code="at0024">
                <items id="text">Autre identificateur</items>
                <items id="description">Identifiant non spécifié, qui peut être précisé dans un modèle ou au moment de l'exécution.</items>
                <items id="comment">Il est souhaitable de coder le nom de l'identifiant à l'aide d'un système de codage, s'il est disponible.</items>
            </items>
            <items code="at0025">
                <items id="text">Version du logiciel</items>
                <items id="description">Identification de la version du logiciel utilisé dans le dispositif médical.</items>
                <items id="comment">Lorsque le dispositif médical est une application logicielle, enregistrez la version du logiciel à l'aide de cet élément de données. Lorsque le dispositif médical comporte plusieurs applications logicielles, enregistrez chaque composant logiciel dans un archétype CLUSTER distinct dans le SLOT Composants - soit en tant qu'instance imbriquée d'un autre archétype CLUSTER.device, soit en utilisant un archétype CLUSTER conçu spécifiquement pour enregistrer les détails du logiciel (mais pas encore disponible au moment de la mise au point de cet archétype).</items>
            </items>
            <items code="at0026">
                <items id="text">Extension</items>
                <items id="description">Informations supplémentaires requises pour tenir compte du contexte local ou pour s'aligner sur d'autres modèles/formalismes de référence.</items>
            </items>
            <items code="at0027">
                <items id="text">Multimédia</items>
                <items id="description">Représentation digitale du dispositif.</items>
                <items id="comment">Par exemple : un schéma technique d'un appareil ou une image digitale.</items>
            </items>
            <items code="SNOMED-CT::257369004">
                <items id="text">Single lumen tube</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.case_identification.v0">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Fallidentifikation</items>
                <items id="description">Zur Erfassung von Details zur Identifikation eines Falls im Gesundheitswesen.</items>
            </items>
            <items code="at0001">
                <items id="text">Fall-Kennung</items>
                <items id="description">Der Bezeichner/die Kennung dieses Falls.</items>
            </items>
            <items code="at0002">
                <items id="text">Fall-Beginn</items>
                <items id="description">Das Datum, an dem der Fall begann/eröffnet wurde.</items>
            </items>
            <items code="at0003">
                <items id="text">Status</items>
                <items id="description">Der Status des Falls. 
Der Status "abgeschlossen" bedeutet, dass dem Patienten die entsprechende Fallnummer zugeordnet wurde. 
Der Status "abgebrochen" bedeutet, dass dem Patienten die entsprechende Fallnummer fälschlicherweise zugeordnet wurde.</items>
            </items>
            <items code="at0004">
                <items id="text">Abgeschlossen</items>
                <items id="description">Dem Patienten wurde die entsprechende Fallkennung zugeordnet.</items>
            </items>
            <items code="at0005">
                <items id="text">Abgebrochen</items>
                <items id="description">Dem Patienten wurde die entsprechende Fallkennung fälschlicherweise zugeordnet.</items>
            </items>
            <items code="at0006">
                <items id="text">identifizierter Fall</items>
                <items id="description">Bezeichnung oder kodierter Text zur Bezeichnung des Falls.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">*Case identification (en)</items>
                <items id="description">*To record case identification details for public health purposes. (en)</items>
            </items>
            <items code="at0001">
                <items id="text">*Case identifier (en)</items>
                <items id="description">*The identifier of this case. (en)</items>
            </items>
            <items code="at0002">
                <items id="text">*Case started (en)</items>
                <items id="description">*The date that the case was commenced. (en)</items>
            </items>
            <items code="at0003">
                <items id="text">*Status (en)</items>
                <items id="description">*The status of the case. A status of completed means the patient has been associated with the given case number.
A status of aborted means the patient was associated with the case number in error. (en)</items>
            </items>
            <items code="at0004">
                <items id="text">*Completed (en)</items>
                <items id="description">*The case has been associated with the given case identifier. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">*Aborted (en)</items>
                <items id="description">*The subject was associated with the case identifier in error. (en)</items>
            </items>
            <items code="at0006">
                <items id="text">*Case identified (en)</items>
                <items id="description">*Text or coded description of the case identified. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.conditional_medication_rules_cistec.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Reservebedingungen - ODER</items>
                <items id="description">Einzelheiten zu den Bedingungen, unter denen die Dosismenge oder die Verabreichungsrate festgelegt wird.</items>
                <items id="comment">Mehrere Replikate dieses Elements in einer Medikationsverordnung werden als logische Disjunktion (ODER) angenommen.</items>
            </items>
            <items code="at0002">
                <items id="text">Bedingung</items>
                <items id="description">Der Wert, der für die zu verabreichende Dosismenge oder Verabreichung erforderlich ist.</items>
            </items>
            <items code="at0004">
                <items id="text">Dosis</items>
                <items id="description">Die zu verabreichende Dosis, wenn die Bedingung zutrifft.</items>
            </items>
            <items code="at0005">
                <items id="text">Bedingungsregel - UND</items>
                <items id="description">Einzelheiten zur Bedingung und der damit verbundenen Dosis oder Verabreichungsrate.</items>
                <items id="comment">Mehrere Replikate dieses Elements in einer Medikationsverordnung werden als logische Konjunktion (UND) angenommen.</items>
            </items>
            <items code="at0006">
                <items id="text">Verabreichungsrate</items>
                <items id="description">Die zu verwendende Dosierungsrate, wenn die Bedingung zutrifft.</items>
            </items>
            <items code="at0007">
                <items id="text">Dosierungsformel</items>
                <items id="description">Die Dosierungsformel, die zur Berechnung der Dosismenge oder Verabreichungsrate verwendet wird.</items>
            </items>
            <items code="at0008">
                <items id="text">Bedingungsname</items>
                <items id="description">Der Name oder die kurze Beschreibung der Bedingung, die für die Verabreichung der entsprechenden Dosis oder Anwendung erforderlich ist.</items>
                <items id="comment">Beispiele: Serumblutzucker, systolischer Blutdruck, INR.
Wenn möglich, wird die Kodierung mit einer Terminologie wie SNOMED-CT oder LOINC empfohlen, insbesondere bei messbaren Zuständen wie Vitalparametern, um die Bedingung berechenbar zu machen.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">*Conditional medication instructions (en)</items>
                <items id="description">*Details of conditions on which determine the dose amount or administration rate. (en)</items>
            </items>
            <items code="at0002">
                <items id="text">*Condition (en)</items>
                <items id="description">*The value which is required for the associated dose amount or admistration to be applied. (en)</items>
            </items>
            <items code="at0004">
                <items id="text">*Dose amount (en)</items>
                <items id="description">*The dose amount to be administered if the condition applies. (en)</items>
            </items>
            <items code="at0005">
                <items id="text">*Condition rule (en)</items>
                <items id="description">*Details of the condition and associated dose amount or administration rate. (en)</items>
            </items>
            <items code="at0006">
                <items id="text">*Dose administration rate (en)</items>
                <items id="description">*The dose administration rate to be used if the condition applies. (en)</items>
            </items>
            <items code="at0007">
                <items id="text">*Dosage formula (en)</items>
                <items id="description">*The dosage formula used to calculate the dose amount or administration rate. (en)</items>
            </items>
            <items code="at0008">
                <items id="text">*Condition name (en)</items>
                <items id="description">*The name or short description of the condition which is required for the associated dose amount or admistration to be applied. (en)</items>
                <items id="comment">*For example: serum blood glucose; systolic blood pressure; INR.
If possible, coding with a terminology such as SNOMED-CT or LOINC is recommended, especially with measurable conditions such as vital parameters, to make the condition computable. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.unit_conversion_reference_cistec.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Referenz für Einheitenumrechnung</items>
                <items id="description">Enthält eine systemtechnische Referenz, die angibt, welcher Eintrag innerhalb der Stammdaten die Berechnung zwischen der dokumentierten Dosiseinheit und anderen Einheiten ermöglicht.</items>
                <items id="comment">Dieser Cluster dient ausschließlich der technischen Nachvollziehbarkeit und Reproduzierbarkeit. Die klinischen Inhalte (Dosis, Einheiten, Substanzen) werden im Dosierungs-Cluster openEHR-EHR-CLUSTER.dosage.v2 dokumentiert; dieser Cluster verweist lediglich auf die Umrechnungsressource.</items>
            </items>
            <items code="at0002">
                <items id="text">Einheitstyp</items>
                <items id="description">Bestimmt, welche Umrechnungstabelle für die Auflösung dieser Einheit heranzuziehen ist.</items>
                <items id="comment">OBSOLET - nur für Rückwärtskompatibilität im Datenmodell enthalten.</items>
            </items>
            <items code="at0004">
                <items id="text">Referenz-ID</items>
                <items id="description">UUID des Datensatzes in der unter "Einheitstyp" ausgewählten Tabelle, der die Umrechnung für diese Einheit definiert.</items>
                <items id="comment">OBSOLET - nur für Rückwärtskompatibilität im Datenmodell enthalten.
Muss eine stabile UUID des referenzierten Tabelleneintrags sein. Die UUID ist selbst versioniert, eine weitere Versionsangabe deshalb überflüssig.</items>
            </items>
            <items code="at0005">
                <items id="text">SubstanceQuantityUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0006">
                <items id="text">BaseQuantityUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0007">
                <items id="text">ProprietaryQuantityUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0008">
                <items id="text">StandardQuantityUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0009">
                <items id="text">FallbackUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0010">
                <items id="text">Referenzierte Dosis</items>
                <items id="description">ID oder Label für die spezifische Dosis, auf die sich diese CLUSTER-Instanz bezieht. Wird bei Medikamentenverordnungen verwendet, die zwei oder mehr verschiedene Dosen enthalten.</items>
                <items id="comment">Die genaue Form oder Syntax der ID ist im Datenmodell nicht definiert. Enthält die Verordnung nur eine Dosis, ist dieses Feld nicht erforderlich und sollte weggelassen oder auf den Standardwert „DEFAULT“ gesetzt werden.</items>
            </items>
            <items code="at0011">
                <items id="text">Einheits-ID</items>
                <items id="description">UUID der Einheit, die die Umrechnung der verordneten Arzneimitteldosis definiert.</items>
            </items>
            <items code="at0012">
                <items id="text">Substanz-ID</items>
                <items id="description">UUID der Substanz, die die Umrechnung der verordneten Arzneimitteldosis definiert.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">Référence de conversion des unités</items>
                <items id="description">Comporte une référence spécifique à la mise en œuvre qui indique quelle table de conversion utiliser et quelle entrée de cette table permet d'effectuer le calcul entre l'unité de dose enregistrée et d'autres unités.</items>
                <items id="comment">Destiné exclusivement à la traçabilité et à la reproductibilité des calculs. Le contenu clinique (dose, unités, substances) reste dans le cluster « Dosage » openEHR-EHR-CLUSTER.dosage.v2 ; ce CLUSTER renvoie uniquement à la ressource de conversion.</items>
            </items>
            <items code="at0002">
                <items id="text">Type d'unité</items>
                <items id="description">Indique quelle table de conversion ou catégorie s'applique pour la résolution de cette unité.</items>
            </items>
            <items code="at0004">
                <items id="text">Identifiant de référence</items>
                <items id="description">UUID de l'enregistrement dans la table sélectionnée (« Type d'unité ») qui définit la conversion pour cette unité.</items>
                <items id="comment">Il doit s’agir d’un UUID stable pour la ligne référencée. L’UUID lui-même étant versionné, un élément de données de version supplémentaire n’est pas nécessaire.</items>
            </items>
            <items code="at0005">
                <items id="text">SubstanceQuantitéUnité</items>
                <items id="description"></items>
            </items>
            <items code="at0006">
                <items id="text">BaseQuantityUnit</items>
                <items id="description"></items>
            </items>
            <items code="at0007">
                <items id="text">Unité de quantité propriétaire</items>
                <items id="description"></items>
            </items>
            <items code="at0008">
                <items id="text">Unité de quantité standard</items>
                <items id="description"></items>
            </items>
            <items code="at0009">
                <items id="text">Unité de secours</items>
                <items id="description"></items>
            </items>
            <items code="at0010">
                <items id="text">Dose de référence</items>
                <items id="description">Identifiant ou libellé de la dose spécifique à laquelle fait référence cette instance CLUSTER. Utilisé pour les ordonnances contenant au moins deux doses différentes.</items>
                <items id="comment">La forme ou la syntaxe exacte de l’identifiant n’est pas définie dans le modèle. Si la prescription ne contient qu’une seule dose, ce champ n’est pas nécessaire et doit être défini sur la valeur par défaut « DEFAULT ».</items>
            </items>
            <items code="at0011">
                <items id="text">Identifiant d'unité</items>
                <items id="description">*UUID of the unit that defines the conversion of the ordered medication dose.(en)</items>
            </items>
            <items code="at0012">
                <items id="text">Identifiant de substance</items>
                <items id="description">*UUID of the substance that defines the conversion of the ordered medication dose.(en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.mixture_medium_selection_cistec.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Auswahl des Mischungsmediums</items>
                <items id="description">Angaben dazu, ob eine Trägerlösung oder ein Lösungsmittel definitiv erforderlich ist oder eine von mehreren Alternativen für die Zubereitung des Medikaments darstellt.</items>
            </items>
            <items code="at0001">
                <items id="text">Verwendungsart</items>
                <items id="description">Die vorgesehene Verwendung dieses Mischungsmediums in der Medikationsverordnung.</items>
                <items id="comment">'Erforderlich' verwenden, wenn das Medium Teil der verordneten Mischung ist. 'Alternative' verwenden, wenn das Medium eine mögliche Option innerhalb einer Optionsgruppe ist.</items>
            </items>
            <items code="at0002">
                <items id="text">Erforderlich</items>
                <items id="description">Das Mischungsmedium ist als Teil der Medikamentenzubereitung erforderlich.</items>
            </items>
            <items code="at0003">
                <items id="text">Alternative</items>
                <items id="description">Das Mischungsmedium ist eine mögliche Option innerhalb einer Optionsgruppe.</items>
            </items>
            <items code="at0005">
                <items id="text">Options-ID</items>
                <items id="description">ID einer bestimmten Option innerhalb einer Optionsgruppe.</items>
                <items id="comment">Dieselbe Options-ID für mehrere Medien verwenden, die zusammen eine Option bilden, zum Beispiel [NaCl 50 ml + Glucose 50 ml]. Unterschiedliche Options-IDs für sich gegenseitig ausschliessende Alternativen verwenden.</items>
            </items>
            <items code="at0006">
                <items id="text">Auswahlregel</items>
                <items id="description">Regel für die Auswahl von Optionen aus der Optionsgruppe.</items>
                <items id="comment">Der Wert sollte bei allen Einträgen derselben Optionsgruppe identisch sein. Bei Verwendungsart 'Erforderlich' in der Regel weglassen.</items>
            </items>
            <items code="at0007">
                <items id="text">Genau eine Option</items>
                <items id="description">Aus der Optionsgruppe ist genau eine Option auszuwählen.</items>
            </items>
            <items code="at0008">
                <items id="text">Eine oder mehrere Optionen</items>
                <items id="description">Aus der Optionsgruppe können eine oder mehrere Optionen ausgewählt werden.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">Sélection du milieu de préparation</items>
                <items id="description">Informations indiquant si une solution porteuse ou un solvant est requis ou représente une option alternative pour la préparation du médicament.</items>
            </items>
            <items code="at0001">
                <items id="text">Type d'utilisation</items>
                <items id="description">L'utilisation prévue de ce milieu de mélange dans la prescription médicamenteuse.</items>
                <items id="comment">Utiliser 'Requis' lorsque le milieu fait partie de la préparation prescrite. Utiliser 'Alternative' lorsque le milieu est une option possible dans un groupe d'options.</items>
            </items>
            <items code="at0002">
                <items id="text">Requis</items>
                <items id="description">Le milieu de préparation est requis dans le cadre de la préparation du médicament.</items>
            </items>
            <items code="at0003">
                <items id="text">Alternative</items>
                <items id="description">Le milieu de préparation est une option possible dans un groupe d'options.</items>
            </items>
            <items code="at0005">
                <items id="text">Identifiant de l'option</items>
                <items id="description">Identifiant d'une option spécifique dans un groupe d'options.</items>
                <items id="comment">Utiliser le même identifiant d'option pour plusieurs milieux qui doivent être utilisés ensemble comme une seule option, par exemple [NaCl 50 ml + glucose 50 ml]. Utiliser des identifiants d'option différents pour des alternatives mutuellement exclusives.</items>
            </items>
            <items code="at0006">
                <items id="text">Règle de sélection</items>
                <items id="description">Règle de sélection des options dans le groupe d'options.</items>
                <items id="comment">La valeur devrait être identique pour tous les membres du même groupe d'options. Généralement omise lorsque le type d'utilisation est 'Requis'.</items>
            </items>
            <items code="at0007">
                <items id="text">Exactement une option</items>
                <items id="description">Exactement une option du groupe d'options doit être sélectionnée.</items>
            </items>
            <items code="at0008">
                <items id="text">Une ou plusieurs options</items>
                <items id="description">Une ou plusieurs options du groupe d'options peuvent être sélectionnées.</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.dose_lead_cistec.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Lead für Dosierung</items>
                <items id="description">Kennzeichnung eines Arzneimittelbestandteils, der als Grundlage für die Dosisberechnung verwendet wurde.</items>
            </items>
            <items code="at0002">
                <items id="text">Ist Lead für Dosierung</items>
                <items id="description">Gibt an, ob dieser Arzneimittelbestandteil als Grundlage für die Dosisberechnung verwendet wurde.</items>
                <items id="comment">Nur bei der Substanz, Substanzgruppe oder dem Kombinationsprodukt auf "True" setzen, die bzw. das als Grundlage der Dosisberechnung ausgewählt wurde. Andernfalls auf "False" setzen oder weglassen.</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">Référence pour dose</items>
                <items id="description">Identification d'un composant du médicament servant de base au calcul de la dose.</items>
            </items>
            <items code="at0002">
                <items id="text">Est référence pour dose</items>
                <items id="description">Indique si ce composant du médicament a servi de base au calcul de la dose.</items>
                <items id="comment">Ne définissez cette valeur sur «True» que pour la substance, le groupe d'ingrédients ou le produit composé sélectionné comme base de calcul de la dose. Dans les autres cas, définissez cette valeur sur «False» ou ne la mentionnez pas.</items>
            </items>
        </term_definitions>
    </component_ontologies>
