                                                        <archetype_id>
                                                            <value>openEHR-EHR-CLUSTER.mixture_medium_selection_cistec.v1</value>
                                                        </archetype_id>
                                                        <term_definitions code="at0000">
                                                            <items id="text">Carrier solution selection</items>
                                                            <items id="description">Details about whether a carrier solution or solvent is required or represents an alternative option for medication preparation.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0001">
                                                            <items id="text">Medium use</items>
                                                            <items id="description">The intended use of this mixture medium in the medication order.</items>
                                                            <items id="comment">Use 'Required' when the medium is definitely part of the ordered mixture. Use 'Alternative' when the medium is one possible option within an option group.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0002">
                                                            <items id="text">Required</items>
                                                            <items id="description">The mixture medium is required as part of the medication preparation.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0003">
                                                            <items id="text">Alternative</items>
                                                            <items id="description">The preparation medium is one possible option within an option group.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0005">
                                                            <items id="text">Option identifier</items>
                                                            <items id="description">Identifier of a specific option within an option group.</items>
                                                            <items id="comment">Use the same option identifier for multiple media that must be used together as one option, for example [NaCl 50 ml + glucose 50 ml]. Use different option identifiers for mutually exclusive alternatives.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0006">
                                                            <items id="text">Selection rule</items>
                                                            <items id="description">Rule for selecting options from the option group.</items>
                                                            <items id="comment">The value should be identical for all members of the same option group. Usually omitted when the inclusion type is 'Required'.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0007">
                                                            <items id="text">Exactly one option</items>
                                                            <items id="description">Exactly one option from the option group is to be selected.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0008">
                                                            <items id="text">One or more options</items>
                                                            <items id="description">One or more options from the option group may be selected.</items>
                                                        </term_definitions>
                                                    </children>
