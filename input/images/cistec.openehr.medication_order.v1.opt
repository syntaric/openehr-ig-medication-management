            <items code="Mio IE">
                <items id="text">Millions d'unités internationale</items>
                <items id="description">Millions d'unités internationale</items>
            </items>
            <items code="J">
                <items id="text">Joule</items>
                <items id="description">Joule</items>
            </items>
            <items code="cal">
                <items id="text">Calorie</items>
                <items id="description">Calorie</items>
            </items>
            <items code="at0000">
                <items id="text">*Dosage (en)</items>
                <items id="description">*The combination of a medication amount and administration timing for a single day, in the context of a medication order or medication management. (en)</items>
                <items id="comment">*For example: '2 tablets at 6pm' or '20 mg three times per day'. Please note: this cluster allows multiple occurrences to enable representation of a complete set of dose patterns for a single dose direction. (en)</items>
            </items>
            <items code="at0037">
                <items id="text">*Daily timing (en)</items>
                <items id="description">*Structured details about the timing pattern for a single day. (en)</items>
                <items id="comment">*For example: 'in the morning', 'at 0600, 1400, 2100'. (en)</items>
            </items>
            <items code="at0102">
                <items id="text">*Administration duration (en)</items>
                <items id="description">*The period of time over which a single dose of the medication or vaccine should be administered. (en)</items>
                <items id="comment">*For example: 'Administer over 10 minutes'. (en)</items>
            </items>
            <items code="at0134">
                <items id="text">*Administration rate (en)</items>
                <items id="description">*The rate at which the medication, such as an infusion, is to be administered. (en)</items>
                <items id="comment">*For example: '200 ml/h'. Use the text data type to record non- or semi-quantifiable instructions. (en)</items>
            </items>
            <items code="at0135">
                <items id="text">*Dose formula (en)</items>
                <items id="description">*The formula used to calculate the dose amount or administration rate where this is dependent on some other factor, such as body weight or surface area. (en)</items>
                <items id="comment">*For example: '10 mg/kg/day'. The result of this formula would normally be held in Dose or Administration rate/duration. Where clinical measurements such as body weight is used in the dose calculation, a LINK attribute should used to specify which particular measurement has been used. (en)</items>
            </items>
            <items code="at0144">
                <items id="text">*Dose (en)</items>
                <items id="description">*The amount of medication administered at one time. (en)</items>
                <items id="comment">*For example: 1 mg, 1.5 ml, 0.125 g; or 1-2 ml, 12.5-20.5 mg. (en)</items>
            </items>
            <items code="at0164">
                <items id="text">*Dosage sequence (en)</items>
                <items id="description">*The intended position of this dosage within the overall sequence of dosages. (en)</items>
                <items id="comment">*For example: '1', '2', '3'. 
Where multiple dosages are expressed, the 'Pattern sequence' makes the order in which they should be executed explicit. For example: (1) 1 tab in the morning, (2) 2 tab at 2pm, (3) 1 tab at night. (en)</items>
            </items>
            <items code="at0176">
                <items id="text">*Alternate dose (en)</items>
                <items id="description">*An alternate representation of the amount of medication administered at one time. (en)</items>
                <items id="comment">*For example, can be used to represent a unit-dose based value such as 'tabs', when the Dose amount is expressed as an SI unit such as 'mg', or where it is required to express the total volume of an infusion as well as the amount of the active ingredient. (en)</items>
            </items>
            <items code="at0178">
                <items id="text">*Dose description (en)</items>
                <items id="description">*Text description of the dose. (en)</items>
                <items id="comment">*For example: "Apply ointment to affected area until it glistens". This element is intended to allow implementers to use the structures for increasing/tapering dosages without necessarily specifying the doses in a structured way. (en)</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-CLUSTER.timing_daily.v1">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Zeitraum Morgen</items>
                <items id="description">Strukturierte Informationen über den geplanten Zeitablauf einer therapeutischen oder diagnostischen Aktivität innerhalb eines Morgens.</items>
            </items>
            <items code="at0003">
                <items id="text">Frequenz</items>
                <items id="description">Die Häufigkeit, mit der die Aktivität pro ein Zeitraum durchgeführt werden soll.</items>
                <items id="comment">Zum Beispiel: "4 mal pro Tag" oder "3 bis 4 mal pro Stunde".</items>
            </items>
            <items code="at0004">
                <items id="text">Zeitraum</items>
                <items id="description">Eine bestimmte Uhrzeit oder ein bestimmtes Zeitintervall für das Stattfinden der Aktivität.</items>
                <items id="comment">Zum Beispiel: "08:00" oder "15:00 - 16:00".
Obwohl ein bestimmter Zeitpunkt erfasst werden kann, ist ein Zeitintervall bzw. Zeitraum für eine „Schema“-Medikamentenverordnung besser geeignet.</items>
            </items>
            <items code="at0014">
                <items id="text">Intervall</items>
                <items id="description">Das Zeitintervall oder der minimale und maximale Zeitspanne zwischen jeder geplanten Aktivität.</items>
                <items id="comment">Zum Beispiel: "Alle 4 Stunden" oder "Alle 4 bis 6 Stunden".</items>
            </items>
            <items code="at0023">
                <items id="text">Ist der genaue Zeitablauf entscheidend?</items>
                <items id="description">Ist der genaue Zeitablauf der Aktivität entscheidend für die Wirksamkeit oder für die Sicherheit oder das Wohlbefinden des Patienten?</items>
                <items id="comment">Zum Beispiel bei der Verabreichung von Antiparkinson-Medikamenten.</items>
            </items>
            <items code="at0024">
                <items id="text">Bei Bedarf</items>
                <items id="description">Als "Wahr" setzen, wenn das Medikament nur zu dem in der „Therapeutischen Anweisung“ angegebenen Zeitpunkt verabreicht werden soll, wenn die Patientin/der Patient dies wünscht.</items>
                <items id="comment">Wenn dies auf True gesetzt ist, sollte der Patientin/dem Patienten das Medikament vor der Verabreichung zu dem in der „Therapeutic Direction“ angegebenen Zeitpunkt aktiv angeboten werden, damit sie/er entscheiden kann, ob sie/er es braucht oder nicht.</items>
            </items>
            <items code="at0025">
                <items id="text">Kriterium "Bei Bedarf"</items>
                <items id="description">Die Bedingung, die eine Aktivität "Bei Bedarf" auslöst.</items>
                <items id="comment">Zum Beispiel: "bei Schmerzen".</items>
            </items>
            <items code="at0026">
                <items id="text">Name des Ereignisses</items>
                <items id="description">Der Name des Ereignisses, das die Aktivität auslöst.</items>
                <items id="comment">Zum Beispiel: "Vor jeder Mahlzeit", "vor dem Schlafengehen", "am Morgen". Es versteht sich, dass diese Begriffe in verschiedenen Kulturen möglicherweise nicht unbedingt den gleichen Zeiten entsprechen. Gegebenenfalls wird die Kodierung mit einer Terminologie empfohlen, z. B. mit HL7 Named Events.</items>
            </items>
            <items code="at0027">
                <items id="text">Beschreibung des Zeitablaufs</items>
                <items id="description">Beschreibung des täglichen Zeitablaufs. Dieses Element soll es ermöglichen, die Strukturen für verschiedene Zeitabläufe zu verwenden, ohne notwendigerweise die Struktur der Zeitabläufe zu spezifizieren.</items>
                <items id="comment">Zum Beispiel: "Morgens und abends nehmen".</items>
            </items>
            <items code="at0035">
                <items id="text">Ein/Aus-Zyklus</items>
                <items id="description">Ein Aktivitätszyklus, bei dem ein Ein/Aus-Zyklus erforderlich ist.</items>
                <items id="comment">Zum Beispiel: "Einen Eisbeutel 20 Minuten lang auflegen, eine Stunde lang weglassen, wiederholen".</items>
            </items>
            <items code="at0036">
                <items id="text">Ein</items>
                <items id="description">Der Zeitraum, in dem die Aktivität ausgeführt werden soll.</items>
            </items>
            <items code="at0037">
                <items id="text">Aus</items>
                <items id="description">Der Zeitraum, in dem die Aktivität NICHT stattfinden soll.</items>
            </items>
            <items code="at0038">
                <items id="text">Wiederholungen</items>
                <items id="description">Die Häufigkeit, mit der der Ein/Aus-Zyklus wiederholt werden soll.</items>
            </items>
            <items code="at0039">
                <items id="text">Bestimmtes Ereignis</items>
                <items id="description">Ein bestimmtes, benanntes Zeitereignis, auf das sich die Aktivität bezieht und stattfinden soll.</items>
            </items>
            <items code="at0040">
                <items id="text">Zeitspanne</items>
                <items id="description">Das Zeitintervall vor oder nach dem Ereignis, in dem die Aktivität ausgeführt werden soll. Negative Intervalle können verwendet werden, um anzugeben, dass die Aktivität vor dem genannten Ereignis ausgeführt werden soll.</items>
                <items id="comment">Zum Beispiel: "30 Minuten nach dem Essen = Mahlzeit + 30 Minuten", "2 Stunden vor dem Schlafengehen = Schlafenszeit - 2 Stunden".</items>
            </items>
        </term_definitions>
        <term_definitions language="fr">
            <items code="at0000">
                <items id="text">Horaire - journalier</items>
                <items id="description">Informations structurées sur le moment prévu pour une activité thérapeutique ou diagnostique au cours d'une période de 24 heures.</items>
            </items>
            <items code="at0003">
                <items id="text">Fréquence</items>
                <items id="description">La fréquence, c'est-à-dire le nombre de fois par période où l'activité doit avoir lieu.</items>
                <items id="comment">Par exemple : "4 fois par jour" ou "3 à 4 fois par heure" : "4 fois par jour" ou "3 à 4 fois par heure".</items>
            </items>
            <items code="at0004">
                <items id="text">Temps spécifique</items>
                <items id="description">Moment précis ou intervalle de temps où l'activité doit se dérouler.</items>
                <items id="comment">Par exemple, "08:00" ou "15:00-16:00" : "08:00" ou "15:00-16:00".</items>
            </items>
            <items code="at0014">
                <items id="text">Intervalle</items>
                <items id="description">Intervalle de temps ou plage minimale et maximale d'un intervalle entre chaque activité programmée.</items>
                <items id="comment">Par exemple : "Toutes les 4 heures" ou "Toutes les 4 à 6 heures" : "Toutes les 4 heures" ou "Toutes les 4 à 6 heures".</items>
            </items>
            <items code="at0023">
                <items id="text">Le moment exact est-il critique ?</items>
                <items id="description">Le moment exact de l'activité est-il essentiel pour l'efficacité, la sécurité ou le bien-être du patient ?</items>
                <items id="comment">Par exemple, lors de l'administration de médicaments antiparkinsoniens.</items>
            </items>
            <items code="at0024">
                <items id="text">Selon les besoins</items>
                <items id="description">Enregistrer comme Vrai si l'activité ne doit avoir lieu que lorsque le critère "'Tel que requis'" est rempli.</items>
                <items id="comment">Appelé "PRN" ("pro re nata", latin : "lorsque la situation se présente") ou "PN" ("per necessare", latin : "lorsque cela est nécessaire") dans certaines cultures.</items>
            </items>
            <items code="at0025">
                <items id="text">Critère en "fonction des besoins"</items>
                <items id="description">La condition qui déclenche une activité "en fonction des besoins".</items>
                <items id="comment">Par exemple : "pour la douleur".</items>
            </items>
            <items code="at0026">
                <items id="text">Nom de l'événement</items>
                <items id="description">Le nom de l'événement qui déclenche l'activité.</items>
                <items id="comment">Par exemple : "Avant chaque repas", "au coucher", "le matin" : "Avant chaque repas", "au coucher", "le matin". Il est entendu que ces noms d'événements peuvent ne pas correspondre exactement aux mêmes heures dans différentes cultures. Il est recommandé de coder avec une terminologie, par exemple HL7 FHIR Named events, le cas échéant.</items>
            </items>
            <items code="at0027">
                <items id="text">Description du timing</items>
                <items id="description">Description textuelle de l'horaire quotidien. Cet élément est destiné à permettre aux responsables de la mise en œuvre d'utiliser les structures pour différents horaires sans nécessairement spécifier les horaires de manière structurée.</items>
                <items id="comment">Par exemple : "Prendre matin et soir".</items>
            </items>
            <items code="at0035">
                <items id="text">Cycle marche/arrêt</items>
                <items id="description">Un cycle d'activité dans lequel un schéma marche-arrêt est requis.</items>
                <items id="comment">Par exemple : "Appliquer une poche de glace pendant 20 minutes : "Appliquer une poche de glace pendant 20 minutes, l'enlever pendant une heure, répéter".</items>
            </items>
            <items code="at0036">
                <items id="text">On</items>
                <items id="description">La période pendant laquelle l'activité doit se dérouler.</items>
            </items>
            <items code="at0037">
                <items id="text">Arrêt</items>
                <items id="description">Période pendant laquelle l'activité ne doit PAS avoir lieu.</items>
            </items>
            <items code="at0038">
                <items id="text">Répétitions</items>
                <items id="description">Le nombre de répétitions du cycle marche/arrêt.</items>
            </items>
            <items code="at0039">
                <items id="text">Événement spécifique</items>
                <items id="description">Un événement temporel spécifique, nommé, par rapport auquel l'activité doit se dérouler.</items>
            </items>
            <items code="at0040">
                <items id="text">Décalage temporel</items>
                <items id="description">Période de temps avant ou après l'événement nommé pendant laquelle l'activité doit avoir lieu. Des durées négatives peuvent être utilisées pour signifier que l'activité doit avoir lieu avant l'événement.</items>
                <items id="comment">Par exemple : "30 minutes après le repas = repas + 30 minutes", "2 heures avant le coucher = coucher -2 heures".</items>
            </items>
        </term_definitions>
    </component_ontologies>
    <component_ontologies archetype_id="openEHR-EHR-INSTRUCTION.medication_order.v3">
        <term_definitions language="de">
            <items code="at0000">
                <items id="text">Medikamentenverordnung</items>
                <items id="description">Verschreibung eines Medikaments, Impfstoffs, Ernährungsprodukts oder anderen therapeutischen Mittels für eine bestimmte Person.</items>
            </items>
            <items code="at0001">
                <items id="text">Verordnung</items>
                <items id="description">Angaben zur Verordnung.</items>
            </items>
            <items code="at0002">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0004">
                <items id="text">Verordnungsgruppierung-ID</items>
                <items id="description">UID einer Medikamentenverordnungsgruppierung, zu dem die Verordnung gehört. Eine Verordnung kann Teil von mehreren Gruppierungen gleichzeitig sein.</items>
                <items id="comment">Medikamentenverordnungsgruppierungen helfen beim Verwalten mehrerer Verordnungen, die gemeinsam begonnen/beendet werden sollen, z.B. im Post-OP Aufwachraum.</items>
            </items>
            <items code="at0005">
                <items id="text">Tree</items>
                <items id="description">@ internal @</items>
            </items>
            <items code="at0008">
                <items id="text">Erweiterung</items>
                <items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items>
                <items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items>
            </items>
            <items code="at0009">
                <items id="text">Allgemeine Beschreibung der Anweisungen</items>
                <items id="description">Gesamtbeschreibung, wie das verordneten Medikament zu verwenden ist.</items>
                <items id="comment">Wenn die Anweisungen zur Dosierung vollständig strukturiert dargestellt werden können, sollte dieses Element ein Freitextäquivalent enthalten, das normalerweise automatisch generiert wird. Wenn es nicht möglich ist, die gewünschten Dosisanweisungen vollständig in strukturierter Form darzustellen, wird eine Teildarstellung nicht empfohlen. Stattdessen sollte die Anweisung nur als Freitext in diesem Datenelement aufgezeichnet werden.</items>
            </items>
            <items code="at0011">
                <items id="text">Startkriterium für die Verordnung</items>
                <items id="description">Eine Bedingung für den Beginn der Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Start, wenn die Symptome wieder auftreten". Dies ist als Voraussetzung gedacht, die den Beginn des gesamten Medikationsverlaufs auslösen soll, und nicht für Verabreichungen "bei Bedarf" innerhalb einer laufenden Verordnung.</items>
            </items>
            <items code="at0012">
                <items id="text">Beginn der Verordnung</items>
                <items id="description">Datum und optionale Uhrzeit für den Beginn der Verwendung des verordneten Arzneimittels bezogen auf die gesamte Arzneimittelverordnung.</items>
                <items id="comment">Wenn die Arzneimittelverordnung nur einen „Therapeutische Anweisung“ CLUSTER enthält, sollte dieses Element identisch mit at0178::„Therapeutische Anweisung Startdatum/-zeit“ in CLUSTER.therapeutic_direction.v1 sein.
Enthält die Arzneimittelverordnung mehrere „Therapeutische Anweisung“ CLUSTER, sollte dieses Element die Startzeit der frühesten at0178:: „Therapeutische Anweisung Startdatum/-zeit“ aller enthaltenen CLUSTER.therapeutic_direction.v1 sein.</items>
            </items>
            <items code="at0013">
                <items id="text">Ende der Verordnung</items>
                <items id="description">Datum und optionale Uhrzeit, wann die Verwendung des verordneten Arzneimittels eingestellt werden soll, bezogen auf die gesamte Arzneimittelverordnung.</items>
                <items id="comment">Wenn die Arzneimittelverordnung nur einen „Therapeutische Anweisung“ CLUSTER enthält, sollte dieses Element identisch mit at0179::„Therapeutische Anweisung Stoppdatum/-zeit“ in CLUSTER.therapeutic_direction.v1 sein.
Enthält die Arzneimittelverordnung mehrere „Therapeutische Anweisung“ CLUSTER, sollte dieses Element die Stoppzeit der spätesten at0179:: „Therapeutische Anweisung Stoppdatum/-zeit“ aller enthaltenen CLUSTER.therapeutic_direction.v1 sein.</items>
            </items>
            <items code="at0016">
                <items id="text">Stopkriterium für die Verordnung</items>
                <items id="description">Eine Bedingung für das Einstellen der Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Beenden nach Abklingen der Symptome".</items>
            </items>
            <items code="at0018">
                <items id="text">Klinische Indikation</items>
                <items id="description">Der klinische Grund für die Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Angina". Die Kodierung der klinischen Indikation mit einer Terminologie wird nach Möglichkeit bevorzugt. Dieses Datenelement kann mehrfach vorkommen. Es ist nicht beabsichtigt, eine Angabe für behördliche Genehmigungszwecke mitzuführen.</items>
            </items>
            <items code="at0044">
                <items id="text">Zusätzliche Anweisung</items>
                <items id="description">Ein zusätzlicher Hinweis zur Verwendung oder Lagerung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: Vorsichtsmaßnahmen wie "Mit dem Essen nehmen", "Grapefruit vermeiden", "In Wasser auflösen", "An einem kühlen, trockenen Ort aufbewahren". Dieses Datenelement kann mehrfach vorkommen und sollte nach Möglichkeit mit einer Referenz-Terminologie kodiert werden.</items>
            </items>
            <items code="at0047">
                <items id="text">Maschinenlesbare Anweisungen</items>
                <items id="description">Eine maschinenlesbare, berechenbare Textdarstellung der Anweisung.</items>
                <items id="comment">Wird normalerweise zum Austausch von Informationen zwischen Legacy-Systemen verwendet. Zum Beispiel: "10mg bd; 20 mg n", wie von der NHS-Dosissyntax verwendet (in Entwicklung).</items>
            </items>
            <items code="at0050">
                <items id="text">Dauer der durchgeführten Verordnung</items>
                <items id="description">Der Zeitraum, in dem die Person / der Patient das verordnete Arzneimittel noch vor der Ausstellung dieser Verordnung bereits angewendet hat.</items>
                <items id="comment">Zum Beispiel: Zur Darstellung, dass der Patient vor einem Krankenhausaufenthalt, im Kontext eines 7-tägigen Kurs, 3 Tage lang Antibiotika eingenommen hat.</items>
            </items>
            <items code="at0051">
                <items id="text">Maximale Dosis</items>
                <items id="description">Details zur maximal zulässigen kumulativen Dosis über einen definierten Zeitraum für das verordnete Arzneimittel.</items>
                <items id="comment">Zum Beispiel: "Bis zu 1 Gramm pro Tag". Dieses Cluster kann mehrmals vorkommen, um die Darstellung mehrerer Maximaldosen zu ermöglichen, die für verschiedene Zeiträume gelten. Die lebenslange Maximaldosis sollte hier nicht mitgeführt werden, da sie sich auf mehrere Aufträge im Zeitverlauf bezieht.</items>
            </items>
            <items code="at0053">
                <items id="text">Zulässige Dauer</items>
                <items id="description">Der Zeitraum, für den die maximale Dosis berechnet wird.</items>
                <items id="comment">Beispiel: 24 Stunden.</items>
            </items>
            <items code="at0060">
                <items id="text">Anwendungen durchgeführt</items>
                <items id="description">Die Anzahl der Verabreichungen des verordneten Arzneimittels, die im Rahmen der geplanten Gesamtverordnung, bereits vor dieser Ausgabe, durchgeführt wurden.</items>
                <items id="comment">Zum Beispiel: Zur Darstellung, dass der Patient die beiden ersten Antibiotika-Tabletten eines dreitägigen Kurses eingenommen hat, bevor er aus dem Krankenhaus in ein Pflegeheim entlassen wurde.</items>
            </items>
            <items code="at0062">
                <items id="text">Arzneimittelsicherheit</items>
                <items id="description">Angaben über die Arzneimittelsicherheit des verordneten Medikaments.</items>
            </items>
            <items code="at0064">
                <items id="text">Beabsichtigte Sicherheitsüberschreitung?</items>
                <items id="description">Bestätigung durch den verschreibenden Arzt, ob die normale Dosis oder andere Sicherheitsgrenzen aufgrund besonderer Umstände überschritten wurden.</items>
            </items>
            <items code="at0065">
                <items id="text">Abgabemenge</items>
                <items id="description">Detaillierte Angaben zur Menge des verordneten Arzneimittels, das abgegeben werden soll.</items>
                <items id="comment">Dieser SLOT ermöglicht die lokaler Unterschiede in den verschiedenen Rechtsordnungen in Bezug auf die Abgabemenge von Arzneimitteln zu verwalten.</items>
            </items>
            <items code="at0069">
                <items id="text">Anweisungen zur Genehmigung</items>
                <items id="description">Details der Autorisierung für das verordnete Arzneimittel, einschließlich Unterstützung der lokalen Richtlinien zur Selbstverwaltung, Ausgabe und Bestätigung.</items>
                <items id="comment">Zum Beispiel: Angaben über Wiederholung oder Nachbereitung. Dieser SLOT ermöglicht lokale Unterschiede zwischen verschiedenen Rechtsordnungen hinsichtlich der Genehmigung und Re-Autorisierung von Arzneimitteln zu verwalten.</items>
            </items>
            <items code="at0070">
                <items id="text">Arzneimittel</items>
                <items id="description">Name des verordneten Medikaments, Impfstoffs oder anderen therapeutischen / verschreibungsfähigen Mittels.</items>
                <items id="comment">Je nach Kontext kann dieses Feld entweder für die generische oder die produktbasierte Verschreibung verwendet werden. In diesem Datenelement können eng gebundene Verordnungen verschiedener Medikamente dargestellt werden, wenn diese als Einzelpackung verschrieben werden. Es wird dringend empfohlen, das „Arzneimittel“ mit einer Terminologie zu kodieren, die nach Möglichkeit eine Entscheidungsunterstützung triggern kann. Der Umfang der Kodierung kann vom einfachen Medikamentennamen bis zu strukturierten Details über die tatsächlich zu verwendende Medikamentenpackung variieren. 
Die Freitexteingabe sollte nur verwendet werden, wenn keine entsprechende Terminologie verfügbar ist.
In KISIM, wenn möglich befüllt mit hospINDEX DSCRD des verordneten Produkts oder Artikels.</items>
            </items>
            <items code="at0091">
                <items id="text">Verabreichungsweg</items>
                <items id="description">Die Angabe darüber, auf welche Art das verordnete Arzneimittel am Körper des Patienten angewendet wird.</items>
                <items id="comment">Zum Beispiel: "oral", "intravenös" oder "topisch". &#13;
Die Kodierung des Verabreichungswegs mit einer Terminologie wird nach Möglichkeit bevorzugt. Es können mehrere mögliche Verabreichungswege angegeben werden.</items>
            </items>
            <items code="at0092">
                <items id="text">Verabreichungsort</items>
                <items id="description">Name der Körperstelle, an der das Arzneimittel verabreicht wird.</items>
                <items id="comment">Zum Beispiel: "linker Oberarm", "intravenöser Katheter rechte Hand".&#13;
Die Kodierung der Körperstelle mit einer Terminologie ist nach Möglichkeit bevorzugt.</items>
            </items>
            <items code="at0093">
                <items id="text">Lokalisation</items>
                <items id="description">Strukturierte Beschreibung der Körperstelle, an der das Arzneimittel verabreicht wird.</items>
            </items>
            <items code="at0094">
                <items id="text">Verabreichungsart</items>
                <items id="description">Die Technik oder das Gerät mit dem das versordnete Arzneimittel verabreicht werden soll.</items>
                <items id="comment">Zum Beispiel: "via Z-track Injektion"; "via Vernebler". Die Kodierung der Methode mit einer Terminologie, wenn möglich, wird bevorzugt.</items>
            </items>
            <items code="at0095">
                <items id="text">Verabreichungsmittel</items>
                <items id="description">Details zu der Vorrichtung mit der das verordnete Arzneimittel verabreicht wird.</items>
            </items>
            <items code="at0105">
                <items id="text">Patienteninformation</items>
                <items id="description">Ein zusätzlicher Hinweis, der sich in erster Linie an die Person/ den Patienten oder Angehörige richtet.</items>
                <items id="comment">Zum Beispiel: "Zur Senkung Ihres Blutdruckes", "Zur Blutverdünnung". Dieses Datenelement kann mehrfach vorkommen und sollte nach Möglichkeit mit einer entsprechenden Terminologie kodiert werden. Bei Bedarf ist es möglich, dieses Element über ein LINK-Attribut z.B. der "ursprünglichen Diagnose" in einer separaten Problemliste zuzuordnen, und die Angabe sollte hier explizit dargestellt werden, da sich das Ziel des Links im Laufe der Zeit ändern kann.</items>
            </items>
            <items code="at0106">
                <items id="text">Abgabehinweis</items>
                <items id="description">Ein zusätzlicher Hinweis richtet sich in erster Linie an die Person, die das verordnete Arzneimittel verteilt.</items>
                <items id="comment">Beispiel: Detaillierte Anweisungen für die schrittweise Abgabe von Opiaten.</items>
            </items>
            <items code="at0107">
                <items id="text">Überwachungshinweis</items>
                <items id="description">Eine zusätzliche Anweisung mit Hinweisen auf die empfohlene oder erforderliche Überwachung bei Verwendung des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Bitte um Überprüfung der Nierenfunktion in 2 Wochen". Dieses Datenelement kann mehrfach vorkommen.</items>
            </items>
            <items code="at0112">
                <items id="text">Zusammenfassung der Verordnung</items>
                <items id="description">Zusammenfassende Informationen zur Verwendung des verordneten Arzneimittels, z. B. aktueller Status oder Schlüsseldaten, die normalerweise in anderen Kontexten außer Verordnung verwendet werden.</items>
                <items id="comment">Eine Zusammenfassung der Verordnung kann erforderlich sein, wenn Arzneimittelinformationen zwischen Systemen übertragen oder eine FHIR- "Medication Statement" dargestellt werden. Zum Beispiel: Als Teil einer Überweisung, einer Übersicht über Notfallpatienten oder Kommunikation bei der Entlassung.</items>
            </items>
            <items code="at0113">
                <items id="text">Detaillierte Angaben zu der Verordnung</items>
                <items id="description">Detaillierte Angaben zu der gesamten Medikamentenverordnung.</items>
            </items>
            <items code="at0129">
                <items id="text">Anweisungen zur Abgabe</items>
                <items id="description">Anweisungen zur Abgabe des verordneten Arzneimittels.</items>
            </items>
            <items code="at0130">
                <items id="text">Höchstmenge</items>
                <items id="description">Die maximale, kumulative Menge an Medikamenten, die innerhalb des zulässigen Zeitraums verabreicht werden sollte.</items>
                <items id="comment">Zum Beispiel: 1 ml, 1,5 mg, 0,125 g.</items>
            </items>
            <items code="at0132">
                <items id="text">Substitutionsanweisung</items>
                <items id="description">Erlaubnis zum Ersatz durch ein bioäquivalentes Arzneimittel.</items>
                <items id="comment">In vielen Ländern ist der Ersatz eines verordneten Arzneimittels mit einer generischen Form oder mit einem anderen Markennamen, der als bioäquivalent bestimmt wurde, zum Zeitpunkt der Abgabe oder Bereitstellung zulässig. In anderen Fällen wird von einer Substitution ausgegangen und der Arzt muss ausdrücklich die Substitution ablehnen.</items>
            </items>
            <items code="at0139">
                <items id="text">Priorität</items>
                <items id="description">Ein Indikator wie dringlich das verordnete Arzneimittel abgegeben werden soll.</items>
                <items id="comment">Zum Beispiel: "Dringend". Dies bleibt dem Template vorbehalten oder auf die lokalen Wertesätze zu spezialisieren. In einigen Rechtsbereichen ist es erlaubt, Anweisungen zur Abgabe als "dringend" zu kennzeichnen, so dass die Apotheke sie schnell bearbeitet.</items>
            </items>
            <items code="at0143">
                <items id="text">Angaben zur Medikation</items>
                <items id="description">Strukturierte Angaben über das gesamte Medikament, einschließlich Stärke, Form und Inhaltsstoffe.</items>
                <items id="comment">Verwenden Sie diesen SLOT, wenn detaillierte Beschreibung des verordneten Arzneimittels explizit angegeben werden muss. Zum Beispiel: Form, Stärke, Verdünnungsmittel oder Mischung von Inhaltsstoffen.</items>
            </items>
            <items code="at0148">
                <items id="text">Therapiezweck</items>
                <items id="description">Gesamttherapeutischer Zweck des verordneten Arzneimittels.</items>
                <items id="comment">Zum Beispiel: "Schmerzlinderung"; "Palliativversorgung"; "Niedrigdosis-Prophylaxe"; "Rehydratation"; "Ernährungsinfusion".</items>
            </items>
            <items code="at0150">
                <items id="text">Tägliche effektive Gesamtdosis</items>
                <items id="description">Angaben zur täglichen Gesamtmenge des verordneten Arzneimittels, das verabreicht werden soll.</items>
                <items id="comment">Die tägliche Gesamtdosis zeichnet die erwartete wirksame Dosis auf und unterstützt somit die Titration einer anfänglichen niedrigen Dosis in Richtung der wirksamen Dosis über einen Zeitraum. Dies ist nicht die Zieldosis oder das Ziel, sondern die tatsächlich wirksame Tagesdosis innerhalb dieses Ziels. In einigen Fällen kann die tägliche Gesamtdosis aus maschinenlesbaren Anweisungen berechnet werden, in anderen Fällen muss sie möglicherweise manuell eingegeben werden.</items>
            </items>
            <items code="at0151">
                <items id="text">Tägliche Gesamtdosis</items>
                <items id="description">Die Gesamtmenge des Arzneimittels, die bei bestimmungsgemäßer Verabreichung täglich angewendet wird.</items>
                <items id="comment">Zum Beispiel "20 mg".</items>
            </items>
            <items code="at0154">
                <items id="text">Ablehnungsgrund der Substitution</items>
                <items id="description">Der Grund warum eine Substitution des verordneten Arzneimittels nicht zulässig ist.</items>
                <items id="comment">Zum Beispiel "Generika sind nicht bioäquivalent".</items>
            </items>
            <items code="at0155">
                <items id="text">Beginn der Abgabe</items>
                <items id="description">Das Datum, ab dem das verordnete Arzneimittel zum ersten Mal abgegeben werden darf.</items>
                <items id="comment">Kann verwendet werden, um die Abgabezeit von Arzneimitteln mit Missbrauchspotenzial zu kontrollieren. Zum Beispiel: Benzodiazepine oder Analgetika.</items>
            </items>
            <items code="at0161">
                <items id="text">Ablaufdatum der Abgabe</items>
                <items id="description">Das Datum, ab dem das Rezept für die legale Abgabe des Arzneimittels nicht mehr gültig ist.</items>
                <items id="comment">In einigen Ländern haben Rezepte zur Abgabe des Arzneimittels ein Ablaufdatum, nach dem die Verordnung nicht mehr abgegeben werden darf.</items>
            </items>
            <items code="at0162">
                <items id="text">Grund der Überschreitung</items>
                <items id="description">Der Grund für eine Überschreitung der klinischen Sicherheit oder maximalen Dosis.</items>
                <items id="comment">Zum Beispiel: "Nicht ansprechbar bei der empfohlenen Höchstdosis. Kritische Situation.", "Penicillin ist die einzige gültige Behandlung, die Wahrscheinlichkeit einer echten Penicillin-Allergie ist gering".</items>
            </items>
            <items code="at0165">
                <items id="text">Zweck</items>
                <items id="description">Beschreibung des Grundes für die Erfassung einer täglichen effektiven Gesamtdosis.</items>
                <items id="comment">Zum Beispiel: "Hypertoniekontrolle", "Zieldosis 20 mg täglich". Die Beschreibung könnte verwendet werden, um einen Namen, Ausdruck oder einen Absatz über den Aufzeichnungszweck der gesamten täglichen Dosis zu identifizieren. Üblicherweise um eine Titration auf eine bestimmte Zieldosis zu ermöglichen.&#13;
Das Ziel oder die Zieldosis kann hier als Teil eines verknüpften EVALUATION-Archetyps "Ziel" (EVALUATION.goal) dargestellt werden.</items>
            </items>
            <items code="at0166">
                <items id="text">Zusätzliche Information</items>
                <items id="description">Zusätzliche strukturierte Angaben über verordnetes Arzneimittel, die nicht in anderen Feldern erfasst wurden.</items>
            </items>
            <items code="at0167">
                <items id="text">Kommentar</items>
                <items id="description">Zusätzliche Kommentare über die Medikamentenverordnung, die nicht in anderen Feldern erfasst wurden.</items>
            </items>
            <items code="at0168">
                <items id="text">Erlaubt</items>
                <items id="description">Die Substitution des Arzneimittels mit einem bioequivalenten Arzneimittel ist erlaubt.</items>
            </items>
            <items code="at0169">
                <items id="text">Nicht erlaubt</items>
                <items id="description">Die Substitution des Arzneimittels mit einem bioequivalenten Arzneimittel ist nicht erlaubt.</items>
            </items>
            <items code="at0170">
                <items id="text">Details der Abgabe</items>
                <items id="description">Weitere detaillierte Angaben zu den Anweisungen zur Abgabe.</items>
                <items id="comment">Dieser Slot erlaubt lokale Unterschiede in den verschiedenen Rechtsbereichen bezüglich der Arzneimittelabgabe.</items>
            </items>
            <items code="at0171">
                <items id="text">Hinweis zur überschrittenen Sicherheitsgrenze</items>
                <items id="description">Ein bekanntes oder anerkanntes Sicherheitsproblem, das für dieses Medikament gilt, wie z. B. eine Allergie, ein Warnhinweis zur Vervielfältigung von Arzneimitteln oder eine Kontraindikation. Dieses Element wird normalerweise nur aufgezeichnet, wenn dieser Sicherheitshinweis außer Kraft gesetzt wird.</items>
                <items id="comment">Zum Beispiel: "Allergisch gegen Penicillin", "Atenolol dupliziert".</items>
            </items>
            <items code="at0173">
                <items id="text">Beschreibung der spezifischen Anweisungen</items>
                <items id="description">Freitextbeschreibung eines bestimmten Teils der Gesamtanweisung.</items>
                <items id="comment">In einigen Kontexten ist es üblich, die gesamte Freitextbeschreibung der Anweisung in spezifischere Segmente aufzuteilen. In Krankenhäusern kann es beispielsweise üblich sein, die gesamten Anweisungen in "Dosismenge" und "Verabreichungszeiten" zu unterteilen, beide als Freitext. Diese Begriffe können im Template oder zur Laufzeit der Anwendung angewendet werden.</items>
            </items>
            <items code="at0174">
                <items id="text">Begründung der Dosis</items>
                <items id="description">Eine Beschreibung der Begründung für die Berechnung einer Dosismenge oder Verabreichungsrate, wenn dies von einem anderen Faktor abhängt.</items>
                <items id="comment">Zum Beispiel: "Angepasst wegen Amputation".</items>
            </items>
            <items code="at0177">
                <items id="text">Strukturierte Dosis- und Zeitangaben</items>
                <items id="description">Details zu strukturierten Dosis- und Zeitangaben</items>
                <items id="comment">Dieser SLOT wurde für die Verwendung mit dem Archetyp CLUSTER.therapeutic_direction konzipiert, um die Erfassung einer komplexen Reihe von Dosierungs- und Zeitangaben zu ermöglichen. Es ist zwar möglich, andere CLUSTER-Archetypen innerhalb dieses SLOTs zu verwenden, aber es wird dringend empfohlen, dies nur dann zu tun, wenn die vorhersehbare Abfragefähigkeit keine Priorität hat.</items>
            </items>
            <items code="at0178">
                <items id="text">Sicherheitsgrenze überschritten</items>
                <items id="description">Überschreiten eines bekannten oder anerkannten Sicherheitshinweis des Medikaments, wie z. B. eine Allergie, eine Warnung vor Drogenmissbrauch oder eine Kontraindikation.</items>
            </items>
            <items code="at0179">
                <items id="text">Klinische Leitlinie</items>
                <items id="description">Empfehlung an die zukünftigen Verordner/Abgeber über die fortlaufende, langjährige Verordnung.</items>
                <items id="comment">Zum Beispiel: "keinen Markenersatz zulassen" oder Ratschläge zur Verwendung einer bestimmten Marke, um Füllstoffe zu vermeiden, die Reaktionen hervorrufen.</items>
            </items>
            <items code="EDQM::20001000">
                <items id="text">Anwendung am Ohr</items>
            </items>
            <items code="EDQM::20002500">
                <items id="text">Buccale Anwendung</items>
            </items>
            <items code="EDQM::20003000">
                <items id="text">Anwendung auf der Haut</items>
            </items>
            <items code="EDQM::20004000">
                <items id="text">dentale Anwendung</items>
            </items>
            <items code="EDQM::20006000">
                <items id="text">endozervikale Anwendung</items>
            </items>
            <items code="EDQM::20007000">
                <items id="text">Anwendung in den Nebenhöhlen</items>
            </items>
            <items code="EDQM::20008000">
                <items id="text">endotracheopulmonale Anwendung</items>
            </items>
            <items code="EDQM::20009000">
                <items id="text">epidurale Anwendung</items>
            </items>
            <items code="EDQM::20010000">
                <items id="text">zum Auftragen auf die Wunde</items>
            </items>
            <items code="EDQM::20011000">
                <items id="text">extraamniotische Anwendung</items>
            </items>
            <items code="EDQM::20011500">
                <items id="text">extrakorporale Anwendung</items>
            </items>
            <items code="EDQM::20087000">
                <items id="text">extrapleurale Anwendung</items>
            </items>
            <items code="EDQM::20013000">
                <items id="text">gastrointestinale Anwendung</items>
            </items>
            <items code="EDQM::20013500">
                <items id="text">zur Anwendung mittels Magensonde</items>
            </items>
            <items code="EDQM::20014000">
                <items id="text">Anwendung am Zahnfleisch</items>
            </items>
            <items code="EDQM::20015000">
                <items id="text">Hämodialyse</items>
            </items>
            <items code="EDQM::20015500">
                <items id="text">zur Implantation</items>
            </items>
            <items code="EDQM::20019500">
                <items id="text">Infiltration</items>
            </items>
            <items code="EDQM::20020000">
                <items id="text">zur Inhalation</items>
            </items>
            <items code="EDQM::20021000">
                <items id="text">intestinale Anwendung</items>
            </items>
            <items code="EDQM::20022000">
                <items id="text">intraamniotische Anwendung</items>
            </items>
            <items code="EDQM::20023000">
                <items id="text">intraarterielle Anwendung</items>
            </items>
            <items code="EDQM::20024000">
                <items id="text">intraartikuläre Anwendung</items>
            </items>
            <items code="EDQM::20025000">
