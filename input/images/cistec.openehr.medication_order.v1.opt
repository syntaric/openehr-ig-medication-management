                                                <archetype_id>
                                                    <value>openEHR-EHR-CLUSTER.conditional_medication_rules_cistec.v1</value>
                                                </archetype_id>
                                                <term_definitions code="at0000">
                                                    <items id="text">Conditional medication instructions - OR</items>
                                                    <items id="description">Details of conditions on which determine the dose amount or administration rate.</items>
                                                    <items id="comment">Multiple replicas of this element are assumed to be in logical disjunction (OR).</items>
                                                </term_definitions>
                                                <term_definitions code="at0002">
                                                    <items id="text">Condition</items>
                                                    <items id="description">The value which is required for the associated dose amount or admistration to be applied.</items>
                                                </term_definitions>
                                                <term_definitions code="at0004">
                                                    <items id="text">Dose amount</items>
                                                    <items id="description">The dose amount to be administered if the condition applies.</items>
                                                </term_definitions>
                                                <term_definitions code="at0005">
                                                    <items id="text">Condition rule - AND</items>
                                                    <items id="description">Details of the condition and associated dose amount or administration rate.</items>
                                                    <items id="comment">Multiple replicas of this element are assumed to be in logical conjunction (AND).</items>
                                                </term_definitions>
                                                <term_definitions code="at0006">
                                                    <items id="text">Dose administration rate</items>
                                                    <items id="description">The dose administration rate to be used if the condition applies.</items>
                                                </term_definitions>
                                                <term_definitions code="at0007">
                                                    <items id="text">Dosage formula</items>
                                                    <items id="description">The dosage formula used to calculate the dose amount or administration rate.</items>
                                                </term_definitions>
                                                <term_definitions code="at0008">
                                                    <items id="text">Condition name</items>
                                                    <items id="description">The name or short description of the condition which is required for the associated dose amount or admistration to be applied.</items>
                                                    <items id="comment">For example: serum blood glucose; systolic blood pressure; INR.
If possible, coding with a terminology such as SNOMED-CT or LOINC is recommended, especially with measurable conditions such as vital parameters, to make the condition computable.</items>
                                                </term_definitions>
                                            </children>
