                                                                        <archetype_id>
                                                                            <value>openEHR-EHR-CLUSTER.dose_lead_cistec.v1</value>
                                                                        </archetype_id>
                                                                        <term_definitions code="at0000">
                                                                            <items id="text">Dose lead</items>
                                                                            <items id="description">Identification of a medication component used as the basis for dose calculation.</items>
                                                                        </term_definitions>
                                                                        <term_definitions code="at0002">
                                                                            <items id="text">Is dose lead</items>
                                                                            <items id="description">Indicates whether this medication component was used as the basis for dose calculation.</items>
                                                                            <items id="comment">Set to "True" only for the substance, ingredient group or combination product selected as the dose calculation basis. Set to False or omit otherwise.</items>
                                                                        </term_definitions>
                                                                    </children>
