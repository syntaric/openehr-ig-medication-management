	original_author = <
		["date"] = <"2026-07-22">
		["name"] = <"Hendrik heiser">
		["organisation"] = <"CISTEC AG">
		["email"] = <"hendrik.heiser@cistec.com">
	>
	lifecycle_state = <"in_development">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Dokumentation, wie eine Trägerlösung oder ein Lösungsmittel bei der Zubereitung eines Medikaments verwendet werden soll.">
			keywords = <"Medikation","Zubereitung","Trägerlösung","Lösungsmittel","Verdünnungsmittel","Alternative","Option">
			use = <"Im Structured details SLOT einer CLUSTER.medication-Instanz verwenden, die eine Trägerlösung oder ein Lösungsmittel repräsentiert. Zur Kennzeichnung, ob das Medium erforderlich ist oder zu einer Gruppe alternativer Zubereitungsmedien gehört.">
			misuse = <"Nicht zur Dokumentation von Dosis, Stärke, Konzentration, Menge oder Kompatibilitätsinformationen verwenden. Nicht zur Dokumentation des bei der Verabreichung tatsächlich verwendeten Mediums verwenden.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record how a carrier solution or solvent is to be used in the preparation of a medication.">
			keywords = <"medication","preparation","carrier solution","solvent","diluent","alternative","option">
			use = <"Use in the Structured details SLOT of a CLUSTER.medication instance representing a carrier solution or solvent. Use to indicate whether the medium is required, or belongs to a group of alternative preparation media.">
			misuse = <"Not to be used to record the medication dose, strength, concentration, amount or compatibility information. Not to be used for recording the medium actually used during administration.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Enregistrer comment une solution porteuse ou un solvant doit être utilisé pour la préparation d'un médicament.">
			keywords = <"médicament","préparation","solution porteuse","solvant","diluant","alternative","option">
			use = <"À utiliser dans le SLOT Structured details d'une instance CLUSTER.medication représentant une solution porteuse ou un solvant. Permet d'indiquer si le milieu est requis ou s'il appartient à un groupe de milieux de préparation alternatifs.">
			misuse = <"Ne pas utiliser pour enregistrer la dose, le dosage, la concentration, la quantité ou des informations de compatibilité. Ne pas utiliser pour enregistrer le milieu effectivement utilisé lors de l'administration.">
		>
	>
	other_details = <
