description
	original_author = <
		["date"] = <"2026-07-16">
		["name"] = <"Hendrik Heiser">
		["organisation"] = <"CISTEC AG">
		["email"] = <"hendrik.heiser@cistec.com">
	>
	lifecycle_state = <"in_development">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Kennzeichnung der Arzneimittelkomponente, die innerhalb strukturierter Medikationsdetails als Grundlage für die Dosisberechnung verwendet wurde.">
			keywords = <"Medikation","Dosisberechnung","Dosierungsgrundlage","Substanz","Inhaltsstoff","Kombinationsprodukt">
			use = <"Im Structured details SLOT einer CLUSTER.medication-Instanz verwenden, die eine Substanz, Substanzgruppe oder ein Kombinationsprodukt repräsentiert. 'Ist Dosierungsgrundlage' auf True setzen, wenn diese Komponente durch die verordnende Person oder Software als Grundlage der Dosisberechnung gewählt wurde.">
			misuse = <"Nicht zur Dokumentation von Dosis, Stärke, Konzentration, Menge, Dosiseinheit, therapeutischer Bedeutung oder Rolle eines Inhaltsstoffs verwenden. Kein Ersatz für explizite Angaben zu Arzneimittelbestandteilen.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To identify the medication component used as the basis for dose calculation within structured medication details.">
			keywords = <"medication","dose calculation","dosage lead","substance","ingredient","combination product">
			use = <"Use in the Structured details SLOT of a CLUSTER.medication instance representing a substance, ingredient group or combination product. Set 'Is dosage lead' to True for the component selected by the prescriber or software as the dose calculation basis.">
			misuse = <"Not to be used to record the dose, strength, concentration, amount, dose unit, therapeutic importance or ingredient role. Not a substitute for explicit medication constituent details.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Identifier le composant médicamenteux utilisé comme base de calcul de la dose dans les détails structurés du médicament.">
			keywords = <"médicament","calcul de dose","base de calcul de dose","substance","constituant","produit combiné">
			use = <"À utiliser dans le SLOT Structured details d'une instance CLUSTER.medication représentant une substance, un groupe de substances ou un produit combiné. Définir 'Est la base de calcul de dose' sur True pour le composant choisi par le prescripteur ou le logiciel comme base de calcul de la dose.">
			misuse = <"Ne pas utiliser pour enregistrer la dose, le dosage, la concentration, la quantité, l'unité de dose, l'importance thérapeutique ou le rôle d'un constituant. Ne remplace pas les détails explicites des constituants du médicament.">
		>
	>
	other_details = <
