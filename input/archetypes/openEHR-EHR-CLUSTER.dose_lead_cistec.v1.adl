		["revision"] = <"1.0.0-alpha.1">
	>

definition
	CLUSTER[at0000] occurrences matches {1..*} matches {    -- Dose lead
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] matches {    -- Is dose lead
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Dose lead">
					description = <"Identification of a medication component used as the basis for dose calculation.">
				>
				["at0002"] = <
					text = <"Is dose lead">
					description = <"Indicates whether this medication component was used as the basis for dose calculation.">
					comment = <"Set to \"True\" only for the substance, ingredient group or combination product selected as the dose calculation basis. Set to False or omit otherwise.">
				>
			>
		>
		["de"] = <
			items = <
				["at0000"] = <
					text = <"Lead für Dosierung">
					description = <"Kennzeichnung eines Arzneimittelbestandteils, der als Grundlage für die Dosisberechnung verwendet wurde.">
				>
				["at0002"] = <
					text = <"Ist Lead für Dosierung">
					description = <"Gibt an, ob dieser Arzneimittelbestandteil als Grundlage für die Dosisberechnung verwendet wurde.">
					comment = <"Nur bei der Substanz, Substanzgruppe oder dem Kombinationsprodukt auf \"True\" setzen, die bzw. das als Grundlage der Dosisberechnung ausgewählt wurde. Andernfalls auf \"False\" setzen oder weglassen.">
				>
			>
		>
		["fr"] = <
			items = <
				["at0000"] = <
					text = <"Référence pour dose">
					description = <"Identification d'un composant du médicament servant de base au calcul de la dose.">
				>
				["at0002"] = <
					text = <"Est référence pour dose">
					description = <"Indique si ce composant du médicament a servi de base au calcul de la dose.">
					comment = <"Ne définissez cette valeur sur «True» que pour la substance, le groupe d'ingrédients ou le produit composé sélectionné comme base de calcul de la dose. Dans les autres cas, définissez cette valeur sur «False» ou ne la mentionnez pas.">
				>
			>
		>
	>
